          "::: {.callout-tip title=\"All detected and assessed stats\" collapse=\"true\"}\n\n\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Sentence = c(\"Tie drm, t(18) = 1.18, d = 0.38.\", \n\"Tie equal, t(31) = 2.68, d = 0.93.\", \"Tie dz, t(32) = 5.36, d = 0.93.\", \n\"Tie drm, t(75) = 2.36, d = 0.27.\", \"Tie eta, F(1, 19) = 8.51, ηp² = .31.\", \n\"Tie omega, F(1, 17) = 9.51, ηp² = .36.\", \"Tie omega, F(2, 35) = 9.51, ηp² = .35.\"\n), \"Effect Size\" = c(\"d = 0.38\", \"d = 0.93\", \"d = 0.93\", \"d = 0.27\", \n\"ηp² = .31\", \"ηp² = .36\", \"ηp² = .35\"), \"Reported Test\" = c(\"t(18) = 1.18\", \n\"t(31) = 2.68\", \"t(32) = 5.36\", \"t(75) = 2.36\", \"F(1, 19) = 8.51\", \n\"F(1, 17) = 9.51\", \"F(2, 35) = 9.51\"), \"Test Type\" = c(\"t-test\", \n\"t-test\", \"t-test\", \"t-test\", \"F-test\", \"F-test\", \"F-test\"), \n    \"d Coherence\" = c(\"no_match\", \"match_under_assumptions\", \n    \"match_under_assumptions\", \"match_under_assumptions\", NA, \n    NA, NA), \"d Assumption\" = c(\"none\", \"independent_equal_n\", \n    \"paired_dz\", \"paired_dz\", NA, NA, NA), \"d Coherence Note\" = c(\"No match under tested assumptions (paired dz, independent equal-n, independent unequal-n range). Tolerance = 0.01. A no-match can occur when fewer than 2 decimal places are reported.\", \n    \"Match under independent-samples equal-n assumption (n1 = n2 = 16.5, N = 33).\", \n    \"Match under paired-samples dz assumption.\", \"Match under paired-samples dz assumption.\", \n    NA, NA, NA), \"eta Coherence\" = c(NA, NA, NA, NA, \"match_under_assumptions\", \n    \"match_under_assumptions\", \"match_under_assumptions\"), \"eta Assumption\" = c(NA, \n    NA, NA, NA, \"partial_eta_squared\", \"partial_eta_squared\", \n    \"partial_eta_squared\"), \"eta Coherence Note\" = c(NA, NA, \n    NA, NA, \"Match under partial eta-squared formula from F and dfs.\", \n    \"Match under partial eta-squared formula from F and