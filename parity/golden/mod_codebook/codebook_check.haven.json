        "t": "chr",
        "v": [
          "This module checks whether each extracted data column is documented in a codebook or README, and flags documented variables that never appear in the data.",
          "We examined 2 codebook/README/label sources and 8 data columns across 2 files.",
          "#### Column Documentation",
          "::: {.panel-tabset}\n\n## labelled.dta\n\n\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Column = c(\"id\", \"q1\", \"age\", \"sex\"), Documented = c(\"no\", \n\"no\", \"yes\", \"yes\"), Label = c(NA, NA, \"Age in years\", \"Sex\"), \n    \"Codebook Variable\" = c(NA, NA, \"age\", \"sex\"), Source = c(NA, \n    NA, \"labelled.dta\", \"labelled.dta\"), Status = c(\"unlabelled\", \n    \"unlabelled\", \"labelled\", \"labelled\")), row.names = c(1L, \n3L, 5L, 7L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 25, FALSE)\n```\n\n\n## labelled.sav\n\n\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Column = c(\"id\", \"q1\", \"age\", \"sex\"), Documented = c(\"no\", \n\"no\", \"yes\", \"yes\"), Label = c(NA, NA, \"Age in years\", \"Sex\"), \n    \"Codebook Variable\" = c(NA, NA, \"age\", \"sex\"), Source = c(NA, \n    NA, \"labelled.dta\", \"labelled.dta\"), Status = c(\"unlabelled\", \n    \"unlabelled\", \"labelled\", \"labelled\")), row.names = c(2L, \n4L, 6L, 8L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 25, FALSE)\n```\n\n\n:::",
          "#### Documented but Unused Variables\n\n1 documented variable was not matched to any data column.",
          "\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Variable = \"q1\", Label = NA_character_, Source = \"labelled.dta\"), row.names = \"q1...3\", class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 15, FALSE)\n```\n"
        ]
