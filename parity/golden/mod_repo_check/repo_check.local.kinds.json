      {
        "t": "chr",
        "v": [
          "#### Repositories",
          "\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Repository = \"<a href='tests/mod_repo_check/fixtures/kinds' target='_blank'>tests/mod_repo_check/fixtures/kinds<\/a>\", \n    Platform = \"local\", \"All Files\" = 11L, \"Data Files\" = 3L, \n    \"Code Files\" = 2L, READMEs = 1L, Archives = 1L), row.names = c(NA, \n-1L), class = c(\"tbl_df\", \"tbl\", \"data.frame\"))\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n",
          "#### Files",
          "\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Repository = c(\"tests/mod_repo_check/fixtures/kinds\", \n\"tests/mod_repo_check/fixtures/kinds\", \"tests/mod_repo_check/fixtures/kinds\", \n\"tests/mod_repo_check/fixtures/kinds\", \"tests/mod_repo_check/fixtures/kinds\", \n\"tests/mod_repo_check/fixtures/kinds\", \"tests/mod_repo_check/fixtures/kinds\", \n\"tests/mod_repo_check/fixtures/kinds\", \"tests/mod_repo_check/fixtures/kinds\", \n\"tests/mod_repo_check/fixtures/kinds\", \"tests/mod_repo_check/fixtures/kinds\"\n), File = c(\"analysis.R\", \"app.jar\", \"bundle.7z\", \"data.nc\", \n\"README\", \"eeg.set\", \"run.log.gz\", \"model.joblib\", \"README.md\", \n\"run.sh\", \"scan.nii.gz\"), Size = c(\"7 B\", \"4 B\", \"6 B\", \"4 B\", \n\"0 B\", \"4 B\", \"3 B\", \"2 B\", \"17 B\", \"9 B\", \"3 B\"), Type = c(\"code\", \n\"archive\", \"archive\", NA, \"readme\", NA, \"archive\", NA, \"readme\", \n\"code\", \"archive\")), row.names = c(NA, -11L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n",
          "README files were found in all repositories.",
          "#### Archive Files\n\nThe following files are not ZIP archives: bundle.7z. We recommend the `.zip` format for archives: only ZIP stores its file listing in a way that lets a tool inspect the contents without downloading the whole archive, so a `.zip` is more discoverable and re-usable than a `.7z`, `.rar`, `.tar` or `.tar.gz`.",
          "#### Unclassified Files\n\n1 file is of a kind metacheck does not know, so it is not counted as data, code or documentation: model.joblib. This is no problem in itself.",
          "#### Files that do not belong in the repository",
          "We left out 2 files that software creates by itself, not the authors: R history (1), temporary files (1). They hold nothing a reader can use, but they clutter the repository, and software can mistake them for real files (for example a `._` copy of a `.csv` for data).",
          "*Remove these:* *Operating system* files: macOS adds a `__MACOSX` folder and a `._` copy of every file it puts in a zip, and `.DS_Store` files to folders; Windows adds `Thumbs.db` and `desktop.ini`. On a Mac, create zips from the command line with `zip -r -X`, or remove them afterwards with `zip -d archive.zip \"__MACOSX/*\" \"*.DS_Store\"`. *RStudio session files* (`.Rproj.user/`) hold open tabs and unsaved edits; *R history* (`.Rhistory`, `.Rapp.history`) lists the commands typed in a session and can hold file paths and passwords; *Jupyter checkpoints* (`.ipynb_checkpoints/`) are automatic copies of notebooks; *compiled Python files* (`__pycache__/`, `.pyc`) are recreated when the code runs; *open-document lock files* (`~$...docx`, `.~lock...#`) are left while a document is open; *editor backups* (`file~`, `.bak`, `.swp`) and *temporary files* (`.tmp`, `.temp`, an interrupted save of R's workspace, `.RDataTmp`) are copies a program made by itself.",
          "*Keep only on purpose:* *version control* folders (`.git`, `.svn`, `.hg`) hold the project's history, which can include earlier versions of files and data that was later removed; *editor settings* (`.idea`, `.vscode`) can hold paths on your own computer. A `.gitignore` based on GitHub's templates (https://github.com/github/gitignore) keeps them out of a repository.",
          "\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Repository = c(\"tests/mod_repo_check/fixtures/kinds\", \n\"tests/mod_repo_check/fixtures/kinds\"), File = c(\".Rapp.history\", \n\".RDataTmp1\"), Kind = c(\"R history\", \"temporary files\")), row.names = c(NA, \n-2L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n",
          "#### File Classification",
          "::: {.callout-note title=\"See how every file was classified and grouped\" collapse=\"true\"}\n\n**code** (2 files)\n\n\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(File = c(\"analysis.R\", \"run.sh\"), Group = c(\"ex1\", \n\"ex1\"), Path = c(\"analysis.R\", \"run.sh\")), row.names = c(NA, \n-2L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n\n\n**data** (3 files)\n\n\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(File = c(\"data.nc\", \"eeg.set\", \"scan.nii.gz\"), \n    Group = c(\"ex1\", \"ex1\", \"ex1\"), Path = c(\"data.nc\", \"eeg.set\", \n    \"scan.nii.gz\")), row.names = c(NA, -3L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n\n\n**documentation** (3 files)\n\n\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(File = c(\"README\", \"run.log.gz\", \"README.md\"), \n    Group = c(\"—\", \"ex1\", \"—\"), Path = c(\"docs/README\", \"logs/run.log.gz\", \n    \"README.md\")), row.names = c(NA, -3L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n\n\n**materials** (1 file)\n\n\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(File = \"app.jar\", Group = \"ex1\", Path = \"app.jar\"), row.names = c(NA, \n-1L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n\n\n**unknown** (2 files)\n\n\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(File = c(\"bundle.7z\", \"model.joblib\"), Group = c(\"—\", \n\"—\"), Path = c(\"bundle.7z\", \"model.joblib\")), row.names = c(NA, \n-2L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n\n\n:::\n"
