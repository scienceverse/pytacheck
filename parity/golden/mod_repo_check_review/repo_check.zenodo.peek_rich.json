          "\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Repository = \"<a href='https://zenodo.org/records/5559101' target='_blank'>zenodo.org/records/5559101<\/a>\", \n    \"Cited in\" = \"text\", Whose = \"the authors', for this paper\", \n    Why = \"a link in the main text, not shown to be anyone else's\"), row.names = c(NA, \n-1L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n",
          "#### Repositories",
          "\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(Repository = \"<a href='https://zenodo.org/records/5559101' target='_blank'>zenodo.org/records/5559101<\/a>\", \n    Platform = \"zenodo\", \"All Files\" = 10L, \"Data Files\" = 4L, \n    \"Code Files\" = 2L, READMEs = 1L, Archives = 2L), row.names = c(NA, \n-1L), class = c(\"tbl_df\", \"tbl\", \"data.frame\"))\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 10, FALSE)\n```\n",
          "#### Files",
