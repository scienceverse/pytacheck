          "\n```{r}\n#| echo: false\n\n\n# table data --------------------------------------\ntable <- structure(list(\"File Name\" = c(NA_character_, NA_character_, \nNA_character_, NA_character_, NA_character_, NA_character_, NA_character_, \nNA_character_, NA_character_, NA_character_, NA_character_), \n    \"% Comments\" = c(\"8%\", \"50%\", \"25%\", \"20%\", \"33%\", \"25%\", \n    \"0%\", \"25%\", \"0%\", \"33%\", \"\"), \"Missing Files\" = c(2L, 1L, \n    1L, 0L, 0L, 1L, 0L, 0L, 1L, 1L, NA), \"Absolute Paths\" = c(2L, \n    0L, 0L, 0L, 1L, 0L, 0L, 0L, 1L, 0L, NA), \"Code Between Libraries\" = c(9L, \n    NA, NA, NA, NA, 1L, NA, NA, 1L, NA, NA)), row.names = c(NA, \n11L), class = \"data.frame\")\n\n# display table -----------------------------------\nmetacheck::report_table(table, \"auto\", 5, FALSE)\n```\n",
