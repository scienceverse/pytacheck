{
  "schema": 1,
  "name": "clinical_trials",
  "version": "0.1.0",
  "title": "Clinical trial checks",
  "description": "Checks for clinical trial reports: finds trial registration numbers from the major registries and flags trials that report none.",
  "authors": ["pytacheck-modules contributors"],
  "license": "MIT",
  "homepage": "https://github.com/thesanogoeffect/pytacheck-modules/tree/main/packs/clinical_trials",
  "fields": ["medicine"],
  "keywords": ["clinical trials", "trial registration", "CONSORT", "ICMJE"],
  "requires": {"pytacheck": ">=0.3"},
  "dependencies": [],
  "presets": {
    "default": {
      "description": "metacheck's default report plus trial registration numbers",
      "extends": ["metacheck::default"],
      "modules": ["trial_registration"]
    },
    "only": {
      "description": "Only the trial registration check",
      "modules": ["trial_registration"]
    }
  }
}
