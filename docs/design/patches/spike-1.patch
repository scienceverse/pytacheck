@@ -0,0 +1,164 @@
+"""I1 and I2: the Doc engine finds exactly what grepl() finds (no false negatives).
+
+I1: every built-in (pattern, icase, perl) triple of the text modules (the census
+bank, 282) plus the case-sensitive probes, on the 21 corpus papers and the demo
+paper: Doc masks equal grepl() on the same field (raw text, the cleaned stage-1
+and stage-2 text, and headers), with both literal sources (word index and scan).
+
+I2: over the recorded regex replay (tests/foundation/data/regex_calls.json.xz), for
+every call that recorded a match, every clause of required_literals() has a piece
+in the casefolded string.
+
+usage (tree root): PYTHONPATH=src:. python spike/invariants.py [--json out.json]
+"""
+
+from __future__ import annotations
+
+import inspect
+import json
+import os
+import sys
+import time
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+
+import pytacheck as pc  # noqa: E402
+from parity import accuracy as A  # noqa: E402
+from pytacheck._r import regex as rx  # noqa: E402
+from pytacheck._r.regex import casefold, grepl  # noqa: E402
+from pytacheck.core import doc as D  # noqa: E402
+from pytacheck.core.patterns import Pat, required_literals  # noqa: E402
+
+BANK = os.path.join(
+    "/tmp/claude-0/-home-user-pytacheck/7a7b1f52-e1d1-55eb-8a56-a5f0943689fa/scratchpad/arch",
+    "census/bank.json",
+)
+PROBES = [
+    ("Figure", False, False),
+    ("OSF", False, False),
+    (r"Table \d", False, False),
+    (r"\bR\b", False, False),
+    ("P", False, True),
+]
+
+
+def i1() -> dict:
+    bank = [tuple(x[:3]) for x in json.load(open(BANK))["patterns"]]
+    triples = list(dict.fromkeys([*bank, *PROBES]))
+    inputs = list(dict.fromkeys(o.input for o in A.load_matrix() if o.kind == "paper"))
+    paths = [*inputs, "demopaper()"]
+    covered = sum(bool(required_literals(p, "pcre" if perl else "tre")) for p, _, perl in triples)
+    mismatches = []
+    checks = 0
+    t0 = time.process_time()
+    for mode in ("index", "scan"):
+        D.LITERALS = mode
+        for path in paths:
+            paper = pc.demopaper() if path == "demopaper()" else pc.read(A.ROOT / path)
+            d = D.Doc.of(paper)
+            fields = {0: d.field(0), 1: d.field(1), 2: d.field(2)}
+            for src, icase, perl in triples:
+                pat = Pat.from_r(src, perl=perl, ignore_case=icase)
+                for stage, texts in fields.items():
+                    want = grepl(src, texts, icase, perl)
+                    got = d.mask(pat, stage, d.all)
+                    checks += 1
+                    if [bool(got >> i & 1) for i in range(d.n)] != list(want):
+                        mismatches.append((mode, path, src, icase, perl, stage))
+                want_h = grepl(src, d.header, icase, perl)
+                got_h = d.header_mask(pat, d.all)
+                checks += 1
+                if [bool(got_h >> i & 1) for i in range(d.n)] != list(want_h):
+                    mismatches.append((mode, path, src, icase, perl, "header"))
+    return {
+        "triples": len(triples),
+        "with_literals": covered,
+        "papers": len(paths),
+        "checks": checks,
+        "mismatches": len(mismatches),
+        "first": mismatches[:10],
+        "cpu_s": round(time.process_time() - t0, 1),
+    }
+
+
+def _bind(fn, args, kwargs):
+    return inspect.signature(fn).bind(*args, **kwargs).arguments
+
+
+def i2() -> dict:
+    from tests.foundation.record_regex_calls import DATA, load
+
+    calls = load(DATA)
+    violations = []
+    tested = 0
+    with_req = 0
+    for name, spec, args, kwargs, expected in calls:
+        matched: list[str] = []
+        try:
+            if spec is not None:
+                pattern, icase, perl, fixed = spec[0], spec[1], spec[2], spec[3]
+                method = name.split(".", 1)[1]
+                s = (
+                    args[0]
+                    if method in ("search", "finditer", "fullmatch", "match", "findall")
+                    else (args[1] if method in ("sub", "subn") else None)
+                )
+                if not isinstance(s, str):
+                    continue
+                if (method in ("search", "fullmatch", "match") and expected is not None) or (method in ("finditer", "findall") and expected) or (method in ("sub", "subn") and expected != s):
+                    matched = [s]
+            else:
+                fn = getattr(rx, name)
+                a = _bind(fn, args, kwargs)
+                pattern = a["pattern"] if "pattern" in a else a.get("split")
+                icase, perl, fixed = (
+                    a.get("ignore_case", False),
+                    a.get("perl", False),
+                    a.get("fixed", False),
+                )
+                if name == "strsplit":
+                    continue
+                x = a["x"]
+                xs = [x] if isinstance(x, str) or x is None else list(x)
+                res = [expected] if isinstance(x, str) or x is None else list(expected or [])
+                if name == "grep":
+                    if a.get("value"):
+                        matched = [v for v in res if isinstance(v, str)]
+                    else:
+                        matched = [xs[i] for i in res] if not a.get("invert") else []
+                elif name == "grepl" or name in ("regextract", "regexec", "regextract_all"):
+                    matched = [v for v, r in zip(xs, res) if r and isinstance(v, str)]
+                elif name in ("sub", "gsub"):
+                    matched = [v for v, r in zip(xs, res) if isinstance(v, str) and r != v]
+        except (TypeError, KeyError, IndexError):
+            continue
+        if fixed or not matched:
+            continue
+        cnf = required_literals(pattern, "pcre" if perl else "tre")
+        tested += len(matched)
+        if not cnf:
+            continue
+        with_req += len(matched)
+        for s in matched:
+            f = casefold(s)
+            for clause in cnf:
+                if not any(piece in f for piece in clause):
+                    violations.append((name, pattern, perl, clause, s[:120]))
+                    break
+    return {
+        "calls": len(calls),
+        "matches_tested": tested,
+        "with_requirements": with_req,
+        "violations": len(violations),
+        "first": violations[:10],
+    }
+
+
+if __name__ == "__main__":
+    out = {"I1": i1(), "I2": i2()}
+    print(json.dumps(out, indent=1, default=str))
+    if "--json" in sys.argv:
+        json.dump(out, open(sys.argv[sys.argv.index("--json") + 1], "w"), indent=1, default=str)
+    sys.exit(1 if out["I1"]["mismatches"] or out["I2"]["violations"] else 0)
