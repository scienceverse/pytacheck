index 0000000..4b126ce
--- /dev/null
+++ b/spike/accuracy_ab.sh
@@ -0,0 +1,15 @@
+#!/bin/bash
+# The accuracy gate on the base tree and the spike tree, interleaved, CPU-timed (user+sys).
+# usage: spike/accuracy_ab.sh BASE TREE OUTDIR ROUNDS [-m module ...]
+B=$1; T=$2; O=$3; N=$4; shift 4
+mkdir -p $O
+export PYTACHECK_RSCRIPT=/opt/mamba/envs/mcref/bin/Rscript
+TIMEFORMAT="%U %S %R"
+for r in $(seq 1 $N); do
+  for side in base tree; do
+    D=$B; [ $side = tree ] && D=$T
+    cd $D
+    { time env PYTHONPATH=$D/src:$D /home/user/pytacheck/.venv/bin/python -m parity accuracy --gate "$@" --report $O/$side.$r.json > $O/$side.$r.log 2>&1 ; } 2> $O/$side.$r.time
+    echo "$side round $r user/sys/wall $(cat $O/$side.$r.time) load=$(cut -d' ' -f1-3 /proc/loadavg)" >> $O/summary.txt
+  done
+done
diff --git a/spike/bench.py b/spike/bench.py
new file mode 100644
index 0000000..3432415
--- /dev/null
+++ b/spike/bench.py
@@ -0,0 +1,235 @@
+"""CPU per module per paper, old (tests/_legacy/modules) against new, on the 21 accuracy papers.
+
+Minimum of ROUNDS interleaved rounds (old and new alternate, their order flips each
+round), time.process_time(), in two modes:
+
+* cold:   a fresh deep copy of the paper per module_run, no run context;
+* shared: one fresh paper, one run context (run_session()), the four modules in a
+          row; the Doc is built first and timed on its own ("doc").
+
+Also: the Doc build broken down (columns + section join, fold, stage-1 clean,
+literal index, a full projection), module_run overhead, work counters, retained
+bytes per Doc (tracemalloc), the index-vs-scan choice (a), and the load average.
+
+usage (tree root): PYTHONPATH=src:. python spike/bench.py [--rounds 5] [--json out.json]
+"""
+
+from __future__ import annotations
+
+import copy
+import gc
+import json
+import os
+import sys
+import time
+import tracemalloc
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+
+import pytacheck as pc  # noqa: E402
+from parity import accuracy as A  # noqa: E402
+from pytacheck._r import regex as rx  # noqa: E402
+from pytacheck.core import doc as D  # noqa: E402
+from pytacheck.core import run as R  # noqa: E402
+from pytacheck.module import module, module_run, run_session  # noqa: E402
+from tests._legacy.modules.ethics_check import ethics_check as old_ethics  # noqa: E402
+from tests._legacy.modules.open_practices import open_practices as old_open  # noqa: E402
+from tests._legacy.modules.ref_consistency import ref_consistency as old_refc  # noqa: E402
+from tests._legacy.modules.stat_p_exact import stat_p_exact as old_pexact  # noqa: E402
+
+ROUNDS = int(sys.argv[sys.argv.index("--rounds") + 1]) if "--rounds" in sys.argv else 5
+MODS = ["ethics_check", "open_practices", "stat_p_exact", "ref_consistency"]
+OLD = {
+    "ethics_check": old_ethics,
+    "open_practices": old_open,
+    "stat_p_exact": old_pexact,
+    "ref_consistency": old_refc,
+}
+PATHS = list(dict.fromkeys(o.input for o in A.load_matrix() if o.kind == "paper"))
+PAPERS = [pc.read(A.ROOT / p) for p in PATHS]
+N = len(PAPERS)
+
+
+def fresh(p):
+    return copy.deepcopy(p)
+
+
+def clock(fn):
+    t = time.process_time()
+    fn()
+    return time.process_time() - t
+
+
+def cold() -> dict:
+    best = {(v, m, k): 1e9 for v in ("old", "new") for m in MODS for k in range(N)}
+    for r in range(ROUNDS):
+        for k, p in enumerate(PAPERS):
+            for m in MODS:
+                order = ("old", "new") if r % 2 == 0 else ("new", "old")
+                for v in order:
+                    q = fresh(p)
+                    target = OLD[m] if v == "old" else m
+                    best[(v, m, k)] = min(best[(v, m, k)], clock(lambda: module_run(q, target)))
+    return {
+        m: {v: 1000 * sum(best[(v, m, k)] for k in range(N)) / N for v in ("old", "new")}
+        for m in MODS
+    }
+
+
+def shared() -> dict:
+    best = {(v, m, k): 1e9 for v in ("old", "new") for m in [*MODS, "doc"] for k in range(N)}
+    for r in range(ROUNDS):
+        for k, p in enumerate(PAPERS):
+            order = ("old", "new") if r % 2 == 0 else ("new", "old")
+            for v in order:
+                q = fresh(p)
+                with run_session():
+                    if v == "new":
+                        best[("new", "doc", k)] = min(
+                            best[("new", "doc", k)], clock(lambda: D.Doc.of(q))
+                        )
+                    for m in MODS:
+                        target = OLD[m] if v == "old" else m
+                        t = clock(lambda: module_run(q, target))
+                        best[(v, m, k)] = min(best[(v, m, k)], t)
+    out = {
+        m: {v: 1000 * sum(best[(v, m, k)] for k in range(N)) / N for v in ("old", "new")}
+        for m in MODS
+    }
+    out["doc"] = {"new": 1000 * sum(best[("new", "doc", k)] for k in range(N)) / N}
+    return out
+
+
+def doc_breakdown() -> dict:
+    parts = {"columns_join": 0.0, "fold": 0.0, "clean": 0.0, "index": 0.0, "projection": 0.0}
+    best = {k: dict.fromkeys(parts, 1000000000.0) for k in range(N)}
+    for _ in range(ROUNDS):
+        for k, p in enumerate(PAPERS):
+            q = fresh(p)
+            d = None
+
+            def build():
+                nonlocal d
+                d = D.Doc._records(q) or D.Doc._fallback(q)
+
+            steps = {
+                "columns_join": build,
+                "fold": lambda: d.fold(),
+                "clean": lambda: d.field(1),
+                "index": lambda: d._literal_rows("the"),
+                "projection": lambda: d.rows(list(D.bits(d.body))),
+            }
+            for name, fn in steps.items():
+                best[k][name] = min(best[k][name], clock(fn))
+    return {p: 1000 * sum(best[k][p] for k in range(N)) / N for p in parts}
+
+
+def literal_choice() -> dict:
+    """(a) the four new modules, shared mode, with the word index and with plain scans."""
+    out = {}
+    for mode in ("index", "scan"):
+        D.LITERALS = mode
+        best = [1e9] * N
+        for _ in range(ROUNDS):
+            for k, p in enumerate(PAPERS):
+                q = fresh(p)
+                with run_session():
+                    t = clock(lambda: [D.Doc.of(q), *[module_run(q, m) for m in MODS]])
+                best[k] = min(best[k], t)
+        out[mode] = 1000 * sum(best) / N
+    D.LITERALS = "index"
+    return out
+
+
+@module(title="Noop", description="nothing")
+def noop(paper):
+    return {}
+
+
+def overhead() -> dict:
+    p = fresh(PAPERS[0])
+    reps = 2000
+    best_run = best_direct = 1e9
+    for _ in range(ROUNDS):
+        best_run = min(best_run, clock(lambda: [module_run(p, noop) for _ in range(reps)]) / reps)
+        best_direct = min(best_direct, clock(lambda: [noop(p) for _ in range(reps)]) / reps)
+    return {
+        "module_run_ms": 1000 * best_run,
+        "direct_ms": 1000 * best_direct,
+        "overhead_ms": 1000 * (best_run - best_direct),
+    }
+
+
+def counters() -> dict:
+    """Counters over one shared pass per paper with the new modules, then a second pass."""
+    R.set_flags(counting=True)
+    R.counters(reset=True)
+    for p in PAPERS:
+        q = fresh(p)
+        with run_session():
+            for m in MODS:
+                module_run(q, m)
+    first = dict(R.counters(reset=True))
+    misses = rx._compile.cache_info().misses
+    for p in PAPERS:
+        q = fresh(p)
+        with run_session():
+            for m in MODS:
+                module_run(q, m)
+    second = dict(R.counters(reset=True))
+    R.set_flags(counting=False)
+    return {
+        "first_pass": first,
+        "second_pass": second,
+        "regex_compiles_second_pass": rx._compile.cache_info().misses - misses,
+        "papers": N,
+    }
+
+
+def memory() -> dict:
+    sizes = []
+    for p in PAPERS:
+        q = fresh(p)
+        gc.collect()
+        tracemalloc.start()
+        with run_session():
+            outs = [module_run(q, m) for m in MODS]
+        del outs
+        gc.collect()
+        before = tracemalloc.get_traced_memory()[0]
+        q._derived.clear()
+        gc.collect()
+        after = tracemalloc.get_traced_memory()[0]
+        tracemalloc.stop()
+        sizes.append(before - after)
+    return {"mean_bytes": sum(sizes) / len(sizes), "max_bytes": max(sizes)}
+
+
+if __name__ == "__main__":
+    load0 = os.getloadavg()
+    # warm up: imports, compiled patterns, both implementations once
+    for p in PAPERS[:3]:
+        for m in MODS:
+            module_run(fresh(p), m)
+            module_run(fresh(p), OLD[m])
+    out = {"rounds": ROUNDS, "papers": N}
+    t0 = time.time()
+    out["cold"] = cold()
+    out["shared"] = shared()
+    out["doc_breakdown"] = doc_breakdown()
+    out["literal_choice"] = literal_choice()
+    out["overhead"] = overhead()
+    out["counters"] = counters()
+    out["memory"] = memory()
+    out["load_avg_start"] = load0
+    out["load_avg_end"] = os.getloadavg()
+    out["wall_s"] = round(time.time() - t0, 1)
+    for mode in ("cold", "shared"):
+        for m in MODS:
+            o, n = out[mode][m]["old"], out[mode][m]["new"]
+            out[mode][m]["ratio"] = o / n if n else None
+    print(json.dumps(out, indent=1))
+    if "--json" in sys.argv:
+        json.dump(out, open(sys.argv[sys.argv.index("--json") + 1], "w"), indent=1)
