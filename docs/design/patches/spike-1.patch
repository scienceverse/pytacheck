@@ -0,0 +1,116 @@
+"""The Doc cache never serves a stale paper where it could matter (ARCHITECTURE.md 2.2, V6).
+
+1. An in-place edit of ``p.text`` between two ``module_run`` calls gives fresh results
+   (modules and the ``text_search`` façade), for a materialised and a raw paper.
+2. Inside a run context with ``PYTACHECK_CHECK_MUTATION=1`` the same edit raises
+   ``StaleDocumentError`` when the context ends.
+3. A raw-record paper keeps one Doc across modules outside any context (no rebuild),
+   and pickle, ``copy`` and ``deepcopy`` never carry the cache.
+
+usage (tree root): PYTHONPATH=src:. python spike/mutation.py
+"""
+
+from __future__ import annotations
+
+import copy
+import os
+import pickle
+import sys
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+
+import pytacheck as pc  # noqa: E402
+from parity.cases import metacheck_defaults  # noqa: E402
+from pytacheck.core import run as R  # noqa: E402
+from pytacheck.core.doc import Doc  # noqa: E402
+from pytacheck.module import module_run, run_session  # noqa: E402
+
+XML = "upstream/metacheck/tests/testthat/fixtures/debruine/debruine-fret.xml"
+NEW = "This study was approved by the institutional review board zzqq."
+checks = []
+
+
+def check(name: str, ok: bool) -> None:
+    checks.append((name, ok))
+    print(("PASS " if ok else "FAIL ") + name)
+
+
+def ethics_found(p: object) -> bool:
+    out = module_run(p, "ethics_check")
+    return any("zzqq" in (t or "") for t in out.table["text"].tolist())
+
+
+for label, make in (
+    ("materialised", lambda: (lambda q: (q.text, q)[1])(pc.read(XML))),
+    ("metacheck-defaults (DataFrame tables)", lambda: _read_defaults()),
+    ("raw records", lambda: pc.read(XML)),
+):
+
+    def _read_defaults():
+        with metacheck_defaults():
+            return pc.read(XML)
+
+    p = make()
+    before = ethics_found(p)
+    pc.text_search(p, "zzqq")  # the façade caches the Doc too
+    if p._raw_records("text") is not None:
+        # a raw paper cannot be edited in place: edit through the API (a new table)
+        t = p.text.copy()
+        t.loc[t.index[1], "text"] = NEW
+        p.text = t
+    else:
+        p.text.loc[p.text.index[1], "text"] = NEW
+    after = ethics_found(p)
+    found = len(pc.text_search(p, "zzqq"))
+    check(f"{label}: module_run after an in-place edit sees it", not before and after)
+    check(f"{label}: text_search after an in-place edit sees it", found == 1)
+
+# 2. the guard inside an explicit context
+R.set_flags(check_mutation=True)
+p = pc.read(XML)
+p.text  # materialise: an in-place edit is possible
+raised = False
+try:
+    with run_session():
+        module_run(p, "ethics_check")
+        p.text.loc[p.text.index[1], "text"] = NEW
+        module_run(p, "open_practices")
+except R.StaleDocumentError:
+    raised = True
+check(
+    "run context + PYTACHECK_CHECK_MUTATION=1: an in-place edit raises StaleDocumentError", raised
+)
+p = pc.read(XML)
+p.text
+ok = True
+try:
+    with run_session():
+        module_run(p, "ethics_check")
+        module_run(p, "open_practices")
+except R.StaleDocumentError:
+    ok = False
+check("run context + guard: no edit, no error", ok)
+R.set_flags(check_mutation=False)
+
+# 3. one Doc for a raw paper across modules; caches never copied
+R.set_flags(counting=True)
+p = pc.read(XML)  # the reader builds a Doc for extract_eq() before the paper is finished
+R.counters(reset=True)
+for m in ("ethics_check", "open_practices", "stat_p_exact", "ref_consistency"):
+    module_run(p, m)
+builds = R.counters(reset=True).get("doc_builds", 0)
+check(f"raw paper, 4 modules without a context: {builds} Doc build(s)", builds == 1)
+R.set_flags(counting=False)
+d = Doc.of(p)
+check("pickle drops the cache", not pickle.loads(pickle.dumps(p))._derived)
+check("deepcopy drops the cache", not copy.deepcopy(p)._derived)
+check("copy drops the cache", not copy.copy(p)._derived)
+check("the cache is reused while unchanged", Doc.of(p) is d)
+p.paper_id = "renamed"
+check("a change through the API rebuilds", Doc.of(p) is not d and Doc.of(p).paper_id == "renamed")
+
+bad = [n for n, ok in checks if not ok]
+print(f"{len(checks)} checks, {len(bad)} failed")
+sys.exit(1 if bad else 0)
