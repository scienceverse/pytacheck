index 0000000..bbd57f7
--- /dev/null
+++ b/src/pytacheck/core/hits.py
@@ -0,0 +1,184 @@
+"""``Hits``: the sentences a search chain found, one bitset per Doc.
+
+metacheck's chains map one to one:
+
+=========================================================  =====================================
+``text_search(paper, P)`` (references excluded, raw text)   ``docs.hits(P)``
+``text_search(text_search(paper, A), B)``                   ``docs.hits(A).where(B)``: B matches
+                                                            the text stage 1 returned (cleaned
+                                                            once), exactly
+``text_search(x, X, exclude = TRUE)``                        ``.without(X)``
+``arrange(factor(paper_id, ids), text_id)``                  ``.ordered(ids)``
+``list(unique(text[flag]))`` per paper                       ``.statements(ids)``
+=========================================================  =====================================
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterator, Sequence
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any
+
+from pytacheck.core.doc import bits
+from pytacheck.core.patterns import Pat, PatternSet
+
+if TYPE_CHECKING:
+    from pytacheck.core.doc import Doc, Docs
+
+__all__ = ["Hits", "Ordered"]
+
+
+@dataclass(frozen=True, slots=True, eq=False)
+class Hits:
+    """Rows found in each Doc of *docs*; the next stage matches text cleaned *stage* times."""
+
+    docs: Docs
+    masks: tuple[int, ...]
+    stage: int = 1
+    #: per Doc, the first pattern of the stage-1 list that matched a row (pattern-major ties)
+    ranks: tuple[dict[int, int], ...] | None = None
+
+    def _next(self, masks: tuple[int, ...]) -> Hits:
+        return Hits(self.docs, masks, self.stage + 1, self.ranks)
+
+    def where(self, ps: Pat | PatternSet) -> Hits:
+        """Keep the rows whose text at this stage also matches *ps*."""
+        return self._next(
+            tuple(
+                d.any(ps, self.stage, m) if m else 0
+                for d, m in zip(self.docs, self.masks, strict=True)
+            )
+        )
+
+    def without(self, ps: Pat | PatternSet) -> Hits:
+        """Drop the rows whose text at this stage matches *ps* (``exclude = TRUE``)."""
+        return self._next(
+            tuple(
+                m & ~d.any(ps, self.stage, m) if m else 0
+                for d, m in zip(self.docs, self.masks, strict=True)
+            )
+        )
+
+    def match(self, ps: Pat | PatternSet) -> tuple[int, ...]:
+        """Per Doc, the rows that match *ps* at this stage (a flag, not a new stage)."""
+        return tuple(
+            d.any(ps, self.stage, m) if m else 0 for d, m in zip(self.docs, self.masks, strict=True)
+        )
+
+    def _combine(self, other: Hits, op: Any) -> Hits:
+        if other.docs is not self.docs or other.stage != self.stage:
+            raise ValueError("combine hits of the same documents and stage")
+        return Hits(
+            self.docs,
+            tuple(op(a, b) for a, b in zip(self.masks, other.masks, strict=True)),
+            self.stage,
+        )
+
+    def __or__(self, other: Hits) -> Hits:
+        return self._combine(other, lambda a, b: a | b)
+
+    def __and__(self, other: Hits) -> Hits:
+        return self._combine(other, lambda a, b: a & b)
+
+    def __sub__(self, other: Hits) -> Hits:
+        return self._combine(other, lambda a, b: a & ~b)
+
+    def __bool__(self) -> bool:
+        return any(self.masks)
+
+    def __len__(self) -> int:
+        return sum(m.bit_count() for m in self.masks)
+
+    def __iter__(self) -> Iterator[tuple[Doc, int]]:
+        for d, m in zip(self.docs, self.masks, strict=True):
+            for i in bits(m):
+                yield d, i
+
+    def ordered(self, levels: Sequence[str] | None = None) -> Ordered:
+        """``arrange(factor(paper_id, levels), text_id)``, NA last, stable over R's order.
+
+        Rows are labelled with their paper's id when it is a level (else ``None``,
+        as ``as.character()`` of a factor gives ``NA``). Identical output rows of
+        Docs sharing a paper id are kept once (``text_search()``'s ``distinct()``).
+        """
+        levels = list(self.docs.paper_ids()) if levels is None else list(levels)
+        level = {p: k for k, p in enumerate(levels)}
+        inf = float("inf")
+        rows: list[tuple[Any, ...]] = []
+        seen: dict[Any, set[tuple[Any, ...]]] = {}
+        repeated = _repeated_ids(self.docs)
+        for k, (d, m) in enumerate(zip(self.docs, self.masks, strict=True)):
+            if not m:
+                continue
+            pid = d.paper_id
+            lv = level.get(pid) if isinstance(pid, str) else None
+            rank = self.ranks[k] if self.ranks is not None else {}
+            dup = pid in repeated
+            for i in bits(m):
+                if dup:
+                    key = d.row_key(i, self.stage)
+                    s = seen.setdefault(pid, set())
+                    if key in s:
+                        continue
+                    s.add(key)
+                t = d.text_id[i]
+                rows.append(
+                    (
+                        inf if lv is None else lv,
+                        t is None,
+                        0 if t is None else t,
+                        rank.get(i, 0),
+                        k,
+                        i,
+                        d,
+                        None if lv is None else pid,
+                    )
+                )
+        rows.sort(key=lambda r: r[:6])
+        return Ordered([(r[6], r[5], r[7]) for r in rows], self.stage, levels, self.docs)
+
+    def statements(self, levels: Sequence[str] | None = None) -> dict[str, list[str]]:
+        return self.ordered(levels).statements()
+
+
+def _repeated_ids(docs: Docs) -> set[Any]:
+    seen: set[Any] = set()
+    rep: set[Any] = set()
+    for d in docs:
+        (rep if d.paper_id in seen else seen).add(d.paper_id)
+    return rep
+
+
+class Ordered:
+    """Rows in output order: ``(doc, row, label)``, the text at *stage*."""
+
+    __slots__ = ("docs", "levels", "rows", "stage")
+
+    def __init__(
+        self,
+        rows: list[tuple[Doc, int, str | None]],
+        stage: int,
+        levels: list[str],
+        docs: Docs | None = None,
+    ):
+        self.rows = rows
+        self.stage = stage
+        self.levels = levels
+        self.docs = docs
+
+    def __len__(self) -> int:
+        return len(self.rows)
+
+    def __iter__(self) -> Iterator[tuple[Doc, int, str | None]]:
+        return iter(self.rows)
+
+    def texts(self) -> list[str | None]:
+        return [d.field(self.stage)[i] for d, i, _ in self.rows]
+
+    def statements(self) -> dict[str, list[str]]:
+        """``list(unique(text))`` per labelled paper, in output order."""
+        out: dict[str, dict[Any, None]] = {}
+        for d, i, label in self.rows:
+            if label is not None:
+                out.setdefault(label, {})[d.field(self.stage)[i]] = None
+        return {k: list(v) for k, v in out.items()}
diff --git a/src/pytacheck/core/index.py b/src/pytacheck/core/index.py
new file mode 100644
index 0000000..9627fc7
--- /dev/null
+++ b/src/pytacheck/core/index.py
@@ -0,0 +1,80 @@
+"""Which rows contain a literal piece: a word index, or a plain scan.
+
+Both answer ``rows(piece)``: the bitset of rows whose casefolded text contains
+*piece*. Pieces hold no whitespace and no comma (:func:`~.patterns.pieces`), so
+an occurrence lies inside one whitespace-delimited token of the raw text, and
+also inside a token of any cleaned stage of it (cleaning only collapses
+whitespace, removes the space of " , " and turns the paragraph marker into
+blank lines). One index over the raw text therefore serves every stage.
+"""
+
+from __future__ import annotations
+
+from bisect import bisect_right
+
+__all__ = ["LiteralScan", "WordIndex"]
+
+
+class WordIndex:
+    """Casefolded tokens -> bitset postings; ``rows(piece)`` ORs the postings of the
+    tokens that contain the piece (one ``str.find`` loop over the vocabulary)."""
+
+    __slots__ = ("_memo", "_post", "_starts", "_vocab")
+
+    def __init__(self, folded: list[str]) -> None:
+        post: dict[str, int] = {}
+        get = post.get
+        for i, s in enumerate(folded):
+            if s:
+                bit = 1 << i
+                for tok in set(s.split()):
+                    post[tok] = get(tok, 0) | bit
+        tokens = list(post)
+        starts = []
+        pos = 0
+        for t in tokens:
+            starts.append(pos)
+            pos += len(t) + 1
+        self._post = [post[t] for t in tokens]
+        self._starts = starts
+        self._vocab = "\0".join(tokens)
+        self._memo: dict[str, int] = {}
+
+    def rows(self, piece: str) -> int:
+        hit = self._memo.get(piece)
+        if hit is not None:
+            return hit
+        vocab, starts, post = self._vocab, self._starts, self._post
+        out = 0
+        k = -1
+        pos = vocab.find(piece)
+        while pos != -1:
+            j = bisect_right(starts, pos) - 1
+            if j != k:
+                out |= post[j]
+                k = j
+            nxt = starts[j + 1] if j + 1 < len(starts) else len(vocab)
+            pos = vocab.find(piece, nxt)
+        self._memo[piece] = out
+        return out
+
+
+class LiteralScan:
+    """The same answer from a scan of the casefolded rows, memoised per piece."""
+
+    __slots__ = ("_folded", "_memo")
+
+    def __init__(self, folded: list[str]) -> None:
+        self._folded = folded
+        self._memo: dict[str, int] = {}
+
+    def rows(self, piece: str) -> int:
+        hit = self._memo.get(piece)
+        if hit is not None:
+            return hit
+        out = 0
+        for i, s in enumerate(self._folded):
+            if piece in s:
+                out |= 1 << i
+        self._memo[piece] = out
+        return out
diff --git a/src/pytacheck/core/output.py b/src/pytacheck/core/output.py
new file mode 100644
index 0000000..a6c279f
--- /dev/null
+++ b/src/pytacheck/core/output.py
@@ -0,0 +1,173 @@
+"""The output boundary: the one place module results become DataFrames.
+
+A module returns a dict, a DataFrame or a :class:`Result`. ``Summary`` rows are
+merged onto the input's summary table as dicts (``module._assemble``); ``Schema``
+declares dtypes explicitly; ``sentence_table`` projects hit rows with the
+columns and dtypes ``text_search()`` gives (invariant V4).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass, field
+from typing import TYPE_CHECKING, Any, Literal
+
+import pandas as pd
+
+from pytacheck._r.frames import bind_rows
+
+if TYPE_CHECKING:
+    from pytacheck.core.doc import Doc
+    from pytacheck.core.hits import Ordered
+
+__all__ = ["Result", "Schema", "Summary", "empty_sentences", "sentence_table", "stack"]
+
+Kind = Literal["string", "Int64", "Float64", "float64", "boolean", "list", "object"]
+
+
+class Schema:
+    """Column names and dtypes, explicit (never derived from annotations)."""
+
+    __slots__ = ("cols",)
+
+    def __init__(self, **cols: Kind | Any) -> None:
+        self.cols: tuple[tuple[str, Any], ...] = tuple(cols.items())
+
+    def dtype(self, kind: Any) -> Any:
+        return object if kind in ("list", "object") else kind
+
+    def series(self, name: str, values: Sequence[Any]) -> pd.Series:
+        kind = dict(self.cols)[name]
+        out: pd.Series = pd.Series(list(values), dtype=self.dtype(kind))
+        return out
+
+    def frame(self, records: Sequence[Mapping[str, Any]]) -> pd.DataFrame:
+        """The one typed construction: a frame of *records* (missing keys are NA)."""
+        return pd.DataFrame(
+            {c: pd.Series([r.get(c) for r in records], dtype=self.dtype(k)) for c, k in self.cols}
+        )
+
+    def columns(self, data: Mapping[str, Sequence[Any]]) -> pd.DataFrame:
+        return pd.DataFrame(
+            {c: pd.Series(list(data[c]), dtype=self.dtype(k)) for c, k in self.cols}
+        )
+
+
+@dataclass
+class Summary:
+    """One row per paper (in ``paper_ids`` order): merged onto the run's summary table."""
+
+    paper_ids: Sequence[str]
+    rows: Mapping[str, Mapping[str, Any]]
+    schema: Schema
+
+    def frame(self) -> pd.DataFrame:
+        """The summary as a DataFrame (``paper_id`` first), for users and the old merge."""
+        data: dict[str, pd.Series] = {"paper_id": pd.Series(list(self.paper_ids), dtype="string")}
+        for c, k in self.schema.cols:
+            data[c] = pd.Series(
+                [self.rows.get(p, {}).get(c) for p in self.paper_ids], dtype=self.schema.dtype(k)
+            )
+        return pd.DataFrame(data)
+
+
+@dataclass(eq=False)
+class Result(Mapping[str, Any]):
+    """What a module returns. It is also the legacy dict (a read-only mapping), so
+    code that calls a module function directly and indexes its result keeps working."""
+
+    table: pd.DataFrame | None = None
+    summary: Summary | pd.DataFrame | None = None
+    traffic_light: str = "info"
+    summary_text: str | None = None
+    report: Any = None
+    na_replace: Any = None
+    extras: dict[str, Any] = field(default_factory=dict)
+
+    def as_dict(self) -> dict[str, Any]:
+        """The legacy dict."""
+        summary = self.summary.frame() if isinstance(self.summary, Summary) else self.summary
+        out: dict[str, Any] = {"table": self.table, "summary_table": summary}
+        if self.na_replace is not None:
+            out["na_replace"] = self.na_replace
+        out.update(traffic_light=self.traffic_light, summary_text=self.summary_text)
+        out["report"] = self.report
+        out.update(self.extras)
+        return out
+
+    def __getitem__(self, key: str) -> Any:
+        return self.as_dict()[key]
+
+    def __iter__(self) -> Any:
+        return iter(self.as_dict())
+
+    def __len__(self) -> int:
+        return len(self.as_dict())
+
+
+def empty_sentences() -> pd.DataFrame:
+    """The columns ``text_search()`` gives when there are no papers (U79)."""
+    return pd.DataFrame(
+        {
+            "text": pd.Series([], dtype="string"),
+            "text_id": pd.Series([], dtype="Int64"),
+            "section_id": pd.Series([], dtype="Int64"),
+            "paragraph_id": pd.Series([], dtype="Int64"),
+            "paper_id": pd.Series([], dtype="string"),
+            "header": pd.Series([], dtype="string"),
+            "section_type": pd.Series([], dtype="string"),
+        }
+    )
+
+
+def sentence_table(
+    rows: Ordered | Any, flags: Mapping[str, Any] | None = None, *, empty: Doc | None = None
+) -> pd.DataFrame:
+    """Rows in order (``(doc, row, label)``, with their texts), projected per Doc, with
+    ``paper_id`` labels and typed flag columns (a constant, or one value per row)."""
+    texts = rows.texts()
+    frames = []
+    run_doc: Any = None
+    run: list[int] = []
+    run_text: list[Any] = []
+    labels: list[str | None] = []
+    for (d, i, label), t in zip(rows, texts, strict=True):
+        if d is not run_doc and run:
+            frames.append(run_doc.rows(run, text=run_text))
+            run, run_text = [], []
+        run_doc = d
+        run.append(i)
+        run_text.append(t)
+        labels.append(label)
+    if run:
+        frames.append(run_doc.rows(run, text=run_text))
+    docs = getattr(rows, "docs", None)
+    template = docs.template() if docs is not None else None
+    if template is not None:  # a paper list whose papers' columns differ: R's one table
+        if frames:
+            frames = [bind_rows([template, *frames])]
+        elif "text" in template.columns and empty is not None and "text" in empty.missing:
+            frames = []
+        empty_frame = template
+    if frames:
+        out = frames[0] if len(frames) == 1 else bind_rows(frames)
+        out["paper_id"] = pd.Series(labels, index=out.index, dtype="string")
+    elif template is not None:
+        out = empty_frame.copy()
+        out["paper_id"] = out["paper_id"].astype("string")
+    elif empty is not None:
+        out = empty.rows([])
+        out["paper_id"] = out["paper_id"].astype("string")
+        if "text" in empty.missing:  # text_search() drops the text column it added
+            out = out.drop(columns="text")
+    else:
+        out = empty_sentences()
+    for name, value in (flags or {}).items():
+        values = value if isinstance(value, list) else [value] * len(out)
+        out[name] = pd.Series(values, index=out.index, dtype="boolean")
+    return out
+
+
+def stack(frames: Sequence[pd.DataFrame]) -> pd.DataFrame:
+    """``dplyr::bind_rows()``: columns unioned in first-seen order, typed NA fill."""
+    return bind_rows(frames)
diff --git a/src/pytacheck/core/patterns.py b/src/pytacheck/core/patterns.py
new file mode 100644
index 0000000..d072bf3
--- /dev/null
+++ b/src/pytacheck/core/patterns.py
@@ -0,0 +1,330 @@
+"""Patterns as values: :class:`Pat`, :class:`PatternSet`, required literals.
+
+A pattern is metacheck's R pattern, verbatim, with its dialect: ``"tre"`` (R's
+default engine), ``"pcre"`` (``perl = TRUE``) or ``"fixed"``. Compilation goes
+through lane 2's translator (:mod:`pytacheck._r.regex`) and nowhere else, so
+a detector gives exactly ``grepl()``'s truth value.
+
+:func:`required_literals` derives, from the translated pattern, a CNF of
+casefolded ASCII pieces: every match contains, for every clause, one of its
+pieces. The Doc engine uses it to skip rows (never to accept them), so it only
+has to be *necessary*: whatever the parser does not understand contributes
+nothing, which only weakens the filter.
+"""
+
+from __future__ import annotations
+
+import functools
+import re
+from collections.abc import Callable, Iterable, Iterator
+from dataclasses import dataclass
+from typing import Literal
+
+import regex
+
+from pytacheck._r.regex import _compile, casefold, translate_pcre, translate_tre
+
+__all__ = ["Pat", "PatternSet", "patterns", "required_literals"]
+
+Dialect = Literal["tre", "pcre", "fixed"]
+CNF = tuple[tuple[str, ...], ...]
+
+
+@dataclass(frozen=True, slots=True)
+class Pat:
+    """One R pattern. Value-equal patterns share their masks in every module."""
+
+    src: str
+    dialect: Dialect = "tre"
+    icase: bool = True
+
+    @classmethod
+    def from_r(
+        cls, p: str, *, perl: bool = False, fixed: bool = False, ignore_case: bool = True
+    ) -> Pat:
+        """The pattern ``grepl(p, ..., ignore.case, perl, fixed)`` searches for."""
+        if fixed:
+            return cls(p, "fixed", False)  # R: fixed = TRUE ignores ignore.case
+        return cls(p, "pcre" if perl else "tre", ignore_case)
+
+    @property
+    def perl(self) -> bool:
+        return self.dialect == "pcre"
+
+    @property
+    def fixed(self) -> bool:
+        return self.dialect == "fixed"
+
+    def detector(self) -> Callable[[str], bool]:
+        """``grepl()`` on one string (not ``None``)."""
+        return _detector(self)
+
+    def literals(self) -> CNF:
+        return _literals(self)
+
+    def validate(self) -> None:
+        """Compile now: raise :class:`~pytacheck._r.regex.RegexError` for a bad pattern."""
+        if not self.fixed:
+            _compile(self.src, self.icase, self.perl, False, True)
+
+    def finder(self) -> regex.Pattern[str]:
+        """The compiled pattern for match extents (TRE: leftmost-longest, as R)."""
+        return _compile(self.src, self.icase, self.perl, self.fixed, True)
+
+
+@dataclass(frozen=True, slots=True)
+class PatternSet:
+    """An ordered any-of: never compiled into one alternation (2.5-4.5x slower)."""
+
+    name: str
+    pats: tuple[Pat, ...]
+
+    def __iter__(self) -> Iterator[Pat]:
+        return iter(self.pats)
+
+    def __len__(self) -> int:
+        return len(self.pats)
+
+
+def patterns(
+    *srcs: str | Pat | Iterable[str], dialect: Dialect = "tre", icase: bool = True, name: str = ""
+) -> PatternSet:
+    """A :class:`PatternSet` of R patterns (strings in *dialect*, or :class:`Pat` values)."""
+    out: list[Pat] = []
+    for s in srcs:
+        if isinstance(s, Pat):
+            out.append(s)
+        elif isinstance(s, str):
+            out.append(Pat(s, dialect, icase))
+        else:
+            out.extend(p if isinstance(p, Pat) else Pat(p, dialect, icase) for p in s)
+    return PatternSet(name, tuple(out))
+
+
+def as_patterns(x: Pat | PatternSet | str) -> tuple[Pat, ...]:
+    if isinstance(x, PatternSet):
+        return x.pats
+    if isinstance(x, Pat):
+        return (x,)
+    return (Pat(x),)
+
+
+# ---------------------------------------------------------------------------
+# Compiled detectors (per process)
+# ---------------------------------------------------------------------------
+
+
+@functools.lru_cache(maxsize=8192)
+def _detector(p: Pat) -> Callable[[str], bool]:
+    if p.fixed:
+        src = p.src
+        return lambda s: src in s
+    search = _compile(p.src, p.icase, p.perl, False, False).search  # posix off: same truth
+    return lambda s: search(s) is not None
+
+
+# ---------------------------------------------------------------------------
+# Required literals
+# ---------------------------------------------------------------------------
+
+_MIN = 3
+# escapes that consume more than one character, or change what follows
+_RISKY = set("xuUcpPNgkoQE0123456789")
+_VERBOSE = re.compile(r"\(\?[a-zA-Z-]*[xX]|\(\?V|\(\?#|\\Q")
+_BRACE = re.compile(r"\{(\d*)(?:,(\d*))?\}")
+_PRINTABLE = re.compile(r"[!-~]+")  # ASCII without controls, space and DEL
+
+
+class _Bail(Exception):
+    """The parser met something it does not model: no requirement at all."""
+
+
+def pieces(literal: str) -> list[str]:
+    """The casefolded ASCII pieces (3+ characters) of a literal run, split on space and ','."""
+    return [
+        piece
+        for piece in re.split(r"[\s,]+", casefold(literal))
+        if len(piece) >= _MIN and _PRINTABLE.fullmatch(piece)
+    ]
+
+
+@functools.lru_cache(maxsize=8192)
+def _literals(p: Pat) -> CNF:
+    return required_literals(p.src, p.dialect)
+
+
+def required_literals(src: str, dialect: Dialect = "tre") -> CNF:
+    """Clauses of pieces such that every match of *src* contains one piece of each clause.
+
+    The pieces are casefolded, so for a case-sensitive pattern the test on the
+    casefolded text is necessary too (casefold works per code point).
+    """
+    if dialect == "fixed":
+        return tuple(dict.fromkeys((pc,) for pc in pieces(src)))
+    try:
+        translated = translate_pcre(src) if dialect == "pcre" else translate_tre(src)
+    except Exception:
+        return ()
+    if _VERBOSE.search(translated):
+        return ()
+    try:
+        cnf = _required(translated)
+    except (_Bail, IndexError, ValueError):
+        return ()
+    return tuple(dict.fromkeys(tuple(dict.fromkeys(c)) for c in cnf))
+
+
+def _class_end(p: str, i: int) -> int:
+    """Index after the ``]`` closing the set opened at ``p[i]`` (`regex` V0 syntax)."""
+    j = i + 1
+    if j < len(p) and p[j] == "^":
+        j += 1
+    if j < len(p) and p[j] == "]":
+        j += 1
+    while j < len(p):
+        c = p[j]
+        if c == "\\":
+            j += 2
+            continue
+        if c == "[" and p.startswith("[:", j):
+            end = p.find(":]", j + 2)
+            if end != -1:
+                j = end + 2
+                continue
+        if c == "]":
+            return j + 1
+        j += 1
+    raise _Bail
+
+
+def _group_end(p: str, i: int) -> int:
+    depth = 0
+    j = i
+    while j < len(p):
+        c = p[j]
+        if c == "\\":
+            j += 2
+            continue
+        if c == "[":
+            j = _class_end(p, j)
+            continue
+        if c == "(":
+            depth += 1
+        elif c == ")":
+            depth -= 1
+            if depth == 0:
+                return j + 1
+        j += 1
+    raise _Bail
+
+
+def _split_top(p: str) -> list[str]:
+    out: list[str] = []
+    start = j = 0
+    while j < len(p):
+        c = p[j]
+        if c == "\\":
+            j += 2
+            continue
+        if c == "[":
+            j = _class_end(p, j)
+            continue
+        if c == "(":
+            j = _group_end(p, j)
+            continue
+        if c == "|":
+            out.append(p[start:j])
+            start = j + 1
+        j += 1
+    out.append(p[start:])
+    return out
+
+
+def _quantifier(p: str, i: int) -> tuple[int, int, bool]:
+    """``(min, next index, quantified)`` for a quantifier at ``p[i]``."""
+    if i >= len(p):
+        return 1, i, False
+    c = p[i]
+    if c in "?*":
+        qmin, i = 0, i + 1
+    elif c == "+":
+        qmin, i = 1, i + 1
+    elif c == "{":
+        m = _BRACE.match(p, i)
+        if m is None:
+            raise _Bail  # a literal brace or something unknown: give up
+        qmin = int(m[1]) if m[1] else 0
+        i = m.end()
+    else:
+        return 1, i, False
+    if i < len(p) and p[i] in "?+":  # lazy / possessive
+        i += 1
+    return qmin, i, True
+
+
+def _best(conj: list[tuple[str, ...]]) -> tuple[str, ...]:
+    return max(conj, key=lambda d: (min(len(x) for x in d), -len(d)))
+
+
+def _required(p: str) -> list[tuple[str, ...]]:
+    """CNF of pieces for a pattern in `regex` V0 syntax (translated from TRE or PCRE)."""
+    branches = _split_top(p)
+    if len(branches) > 1:
+        union: list[str] = []
+        for b in branches:
+            cnf = _required(b)
+            if not cnf:
+                return []
+            union.extend(_best(cnf))
+        return [tuple(dict.fromkeys(union))]
+
+    conj: list[tuple[str, ...]] = []
+    run: list[str] = []
+
+    def flush() -> None:
+        if run:
+            conj.extend((pc,) for pc in pieces("".join(run)))
+            run.clear()
+
+    i, n = 0, len(p)
+    while i < n:
+        c = p[i]
+        inner: str | None = None
+        char: str | None = None
+        if c == "\\":
+            if i + 1 >= n:
+                raise _Bail
+            e = p[i + 1]
+            if e in _RISKY:
+                raise _Bail
+            i += 2
+            if not e.isalnum():
+                char = e  # an escaped symbol stands for itself
+        elif c == "[":
+            i = _class_end(p, i)
+        elif c == "(":
+            j = _group_end(p, i)
+            body = p[i + 1 : j - 1]
+            if not body.startswith("?"):
+                inner = body
+            elif body.startswith("?:"):
+                inner = body[2:]
+            i = j  # lookarounds, flags, named or atomic groups: nothing required
+        elif c in ".^$":
+            i += 1
+        elif c in "*+?{)|":
+            raise _Bail  # a quantifier without an atom (or a stray bracket)
+        else:
+            char = c
+            i += 1
+        qmin, i, quantified = _quantifier(p, i)
+        if char is not None and not quantified:
+            run.append(char)
+            continue
+        if char is not None and qmin >= 1:
+            run.append(char)
+        flush()
+        if inner is not None and qmin >= 1:
+            conj.extend(_required(inner))
+    flush()
+    return conj
