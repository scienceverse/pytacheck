index 0000000..61512f3
--- /dev/null
+++ b/spike/diff_text_search.py
@@ -0,0 +1,208 @@
+"""Differential test: the worktree's text_search() against perf base's (legacy) one.
+
+Usage: PYTHONPATH=<wt>/src:<wt> python diff_text_search.py [LEGACY_SEARCH_PY]
+
+Loads the legacy text/search.py as a separate module (it imports the rest of
+pytacheck from the worktree, so only text_search differs), then runs both on
+papers, paper lists, tables (odd ones too) and strings, over many patterns and
+all flag/return combinations, and compares results exactly (dtypes, index,
+column order) or the exceptions (type and message).
+"""
+
+import importlib.util
+import os
+import random
+import sys
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+import pandas as pd  # noqa: E402
+
+import pytacheck as pc  # noqa: E402
+from parity import accuracy as A  # noqa: E402
+from pytacheck.modules import ethics_check as E  # noqa: E402
+from pytacheck.modules import funding_check_oi as F  # noqa: E402
+from pytacheck.modules import open_practices as O  # noqa: E402
+from pytacheck.papers.model import PaperList  # noqa: E402
+from pytacheck.text import extract as X  # noqa: E402
+from pytacheck.text.search import _text_frame  # noqa: E402
+from pytacheck.text.search import text_search as new  # noqa: E402
+
+legacy_path = sys.argv[1] if len(sys.argv) > 1 else "tests/_legacy/search.py"
+spec = importlib.util.spec_from_file_location("legacy_search", legacy_path)
+L = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(L)
+old = L.text_search
+
+inputs = list(dict.fromkeys(o.input for o in A.load_matrix() if o.kind == "paper"))
+papers = [pc.read(A.ROOT / i) for i in inputs]
+rng = random.Random(1)
+
+
+def run(fn, *a, **k):
+    try:
+        return ("ok", fn(*a, **k))
+    except Exception as exc:
+        return ("err", f"{type(exc).__name__}: {exc}")
+
+
+n_cases = 0
+failures = []
+
+
+def same(a, b):
+    if a[0] != b[0]:
+        return False
+    if a[0] == "err":
+        return a[1] == b[1]
+    x, y = a[1], b[1]
+    if isinstance(x, pd.DataFrame) or isinstance(y, pd.DataFrame):
+        if not (isinstance(x, pd.DataFrame) and isinstance(y, pd.DataFrame)):
+            return False
+        if list(x.columns) != list(y.columns) or list(x.dtypes) != list(y.dtypes):
+            return False
+        try:
+            pd.testing.assert_frame_equal(x, y, check_exact=True)
+        except AssertionError:
+            return False
+        return True
+    return x == y
+
+
+def check(label, paper, *a, **k):
+    global n_cases
+    n_cases += 1
+    r_old = run(old, paper, *a, **k)
+    r_new = run(new, paper, *a, **k)
+    if not same(r_old, r_new):
+        failures.append(
+            (
+                label,
+                a,
+                k,
+                r_old if r_old[0] == "err" else "frame",
+                r_new if r_new[0] == "err" else "frame",
+            )
+        )
+
+
+PATTERNS = [
+    ".*",
+    "ethic",
+    "the",
+    "data",
+    r"\bR\b",
+    "zzzqqq",
+    "significan",
+    r"p\s*[<=>]",
+    "approv|ethic",
+    "[",
+    "(a",
+    "interest",
+    r"\d+",
+    "osf\\.io",
+    "\\bsee\\b",
+]
+LISTS = [
+    ["ethic", "approv"],
+    ["zzz", "yyy"],
+    ["data", "code", "the"],
+    ["the", "the"],
+    list(E._ETHICS_WORDS),
+    list(X._LIVE_WORDS),
+    list(O._REPO_WORDS),
+    list(O._AVAILABILITY),
+    list(F.PATTERN_FUND),
+    list(F.PATTERN_STUDY),
+    ["ethic", "[bad"],
+    ["[bad", "ethic"],
+    [r"\binterests?\b", r"\bCOI\b"],
+    list(X._OPERATORS),
+]
+RETURNS = ["sentence", "paragraph", "section", "header", "match", "paper_id"]
+
+# papers: every pattern and list, main flags
+for p, name in zip(papers, inputs, strict=True):
+    for pat in PATTERNS + LISTS:
+        check(name, p, pat)
+    for pat in rng.sample(PATTERNS + LISTS, 6):
+        for ret in RETURNS:
+            check(name, p, pat, return_=ret)
+    for pat in rng.sample(PATTERNS + LISTS, 5):
+        for kw in (
+            {"exclude": True},
+            {"search_header": True},
+            {"include_refs": True},
+            {"ignore_case": False},
+            {"fixed": True},
+            {"perl": True},
+            {"exclude": True, "return_": "paragraph"},
+            {"search_header": True, "return_": "section"},
+        ):
+            check(name, p, pat, **kw)
+
+# paper lists
+pl = PaperList(papers[:6])
+for pat in PATTERNS[:8] + LISTS[:6]:
+    for ret in RETURNS:
+        check("paperlist", pl, pat, return_=ret)
+    check("paperlist-excl", pl, pat, exclude=True)
+for pat in ["ethic", ["a", "b"]]:
+    for ret in RETURNS:
+        check("empty-list", PaperList([]), pat, return_=ret)
+check("plain-list", papers[:3], "ethic")
+check("bad-input", 42, "ethic")
+check("bad-input-multi", 42, ["ethic", "x"])
+check("bad-input-badpat", 42, ["[", "x"])
+
+# tables: chains and odd tables
+frames = [_text_frame(p)[0] for p in papers]
+for f, name in zip(frames, inputs, strict=True):
+    sub = old(f, "the")
+    for pat in PATTERNS[:10] + LISTS[:8]:
+        check(name + "/chain", sub, pat)
+        check(name + "/chain-excl", sub, pat, exclude=True)
+    odd = f.copy()
+    odd.index = range(100, 100 + len(odd))
+    check(name + "/odd-index", odd, ["the", "data"])
+    check(name + "/odd-index1", odd, "data", return_="paragraph")
+    dup = pd.concat([f.head(5), f.head(5)])
+    for ret in RETURNS:
+        check(name + "/dup", dup, ["the", "a"], return_=ret)
+        check(name + "/dup1", dup, "e", return_=ret)
+    if len(f):
+        notext = f.drop(columns="text")
+        check(name + "/notext", notext, ["1", "2"])
+        check(name + "/notext1", notext, "1")
+        noheader = f.drop(columns=["header", "section_type"])
+        for ret in RETURNS:
+            check(name + "/nohdr", noheader, ["the", "data"], return_=ret)
+        obj = f.astype({"text": object})
+        check(name + "/objtext", obj, ["the", "zzz"])
+        check(name + "/objtext-none", obj, ["zzz", "yyy"])
+        check(name + "/objtext1", obj, "zzz")
+        check(name + "/objtext-excl", obj, ["the", "zzz"], exclude=True)
+        na = f.copy()
+        na.loc[na.index[:3], "text"] = pd.NA
+        check(name + "/na", na, ["the", "a"], exclude=True)
+        check(name + "/na2", na, ["the", "a"])
+        check(name + "/na3", na, "e", return_="section")
+
+simple = pd.DataFrame({"text": ["a", "b", "a b", "c"]})
+for pat in ["a", ["a", "b"], ["zz", "yy"], ["a", "b", "c"], ["a", "b", "c", "d"]]:
+    for ex in (False, True):
+        for ret in RETURNS:
+            check("simple", simple, pat, exclude=ex, return_=ret)
+strings = ["ethics approval here", "no", "approv only", "no", "  spaced   , text  "]
+for pat in ["a", ["ethic", "approv"], ["zz", "yy"], ["e", "o", "zz"], "spaced"]:
+    for ex in (False, True):
+        for ret in RETURNS:
+            check("strings", strings, pat, exclude=ex, return_=ret)
+            check("string", strings[0], pat, exclude=ex, return_=ret)
+check("badret", strings, "a", return_="nope")
+check("emptypat", strings, [])
+
+print(f"{n_cases} cases, {len(failures)} differ")
+for f in failures[:30]:
+    print("DIFF", f[0], str(f[1])[:80], f[2], str(f[3])[:200], "|", str(f[4])[:200])
