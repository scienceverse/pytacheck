+#!/bin/bash
+# The four differential suites of the spike plan, old (tests/_legacy) against new.
+# usage: spike/diff_suites.sh   (from the tree root)
+T=${T:-$(cd "$(dirname "$0")/.." && pwd)}
+cd $T
+PY="/home/user/pytacheck/.venv/bin/python"
+export PYTHONPATH=$T/src:$T PYTHONDONTWRITEBYTECODE=1
+for s in diff_text_search diff_text_frame diff_paper_id diff_text_expand; do
+  echo "== $s"
+  $PY spike/$s.py 2>&1 | tail -15
+done
