diff --git a/spike/ab_outputs.py b/spike/ab_outputs.py
new file mode 100644
index 0000000..0404af0
--- /dev/null
+++ b/spike/ab_outputs.py
@@ -0,0 +1,187 @@
+"""The four rewritten modules against their frozen legacy versions (tests/_legacy/modules).
+
+25 inputs (the 21 accuracy papers, the demo paper, the psychsci list, the 21-paper
+list with 4 repeated ids, a 3-paper list) x 6 elements (table with check_exact and
+dtypes, summary_table with list columns, traffic_light, summary_text, report,
+na_replace), all through module_run on fresh deep copies. Also: chained runs (the
+dict summary merge against DataFrame.merge, with a clashing column suffix) and the
+duplicate-id list quantified per module.
+
+usage (tree root): PYTHONPATH=src:. python spike/ab_outputs.py [--json out.json]
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+import sys
+import traceback
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+
+import pandas as pd  # noqa: E402
+
+import pytacheck as pc  # noqa: E402
+from parity import accuracy as A  # noqa: E402
+from parity.canonical import _encode  # noqa: E402
+from pytacheck.module import module_run  # noqa: E402
+from tests._legacy.modules.ethics_check import ethics_check as old_ethics  # noqa: E402
+from tests._legacy.modules.open_practices import open_practices as old_open  # noqa: E402
+from tests._legacy.modules.ref_consistency import ref_consistency as old_refc  # noqa: E402
+from tests._legacy.modules.stat_p_exact import stat_p_exact as old_pexact  # noqa: E402
+
+MODULES = {
+    "ethics_check": old_ethics,
+    "open_practices": old_open,
+    "stat_p_exact": old_pexact,
+    "ref_consistency": old_refc,
+}
+ELEMENTS = ("table", "summary_table", "traffic_light", "summary_text", "report", "na_replace")
+
+
+def inputs() -> tuple[list[tuple[str, object]], tuple[str, object]]:
+    paths = list(dict.fromkeys(o.input for o in A.load_matrix() if o.kind == "paper"))
+    papers = [pc.read(A.ROOT / p) for p in paths]
+    out: list[tuple[str, object]] = [(os.path.basename(p), q) for p, q in zip(paths, papers)]
+    out.append(("demo", pc.demopaper()))
+    out.append(
+        ("psychsci_list", pc.read(A.ROOT / "upstream/metacheck/tests/testthat/fixtures/psychsci"))
+    )
+    uniq = {}
+    for q in papers:
+        uniq.setdefault(q.paper_id, q)
+    out.append(("list3", pc.PaperList(list(uniq.values())[:3])))
+    dup = ("list21_dup_ids", pc.PaperList(papers))
+    return out, dup
+
+
+def same(a: object, b: object) -> str | None:
+    if isinstance(a, pd.DataFrame) or isinstance(b, pd.DataFrame):
+        if not (isinstance(a, pd.DataFrame) and isinstance(b, pd.DataFrame)):
+            return f"type {type(a).__name__} vs {type(b).__name__}"
+        if list(a.columns) != list(b.columns):
+            return f"columns {list(a.columns)} vs {list(b.columns)}"
+        if [str(t) for t in a.dtypes] != [str(t) for t in b.dtypes]:
+            return f"dtypes {dict(a.dtypes)} vs {dict(b.dtypes)}"
+        try:
+            pd.testing.assert_frame_equal(a, b, check_exact=True)
+        except AssertionError as exc:
+            return str(exc)[:400]
+        return None
+    ea, eb = (
+        json.dumps(_encode(a), sort_keys=True, default=str),
+        json.dumps(_encode(b), sort_keys=True, default=str),
+    )
+    return None if ea == eb else f"{ea[:300]} | {eb[:300]}"
+
+
+def run(x: object, module: object) -> tuple[str, object]:
+    try:
+        return "ok", module_run(copy.deepcopy(x), module)
+    except Exception as exc:
+        return "err", f"{type(exc).__name__}: {str(exc)[:200]}"
+
+
+def compare(label: str, x: object, name: str, old: object) -> list[tuple[str, str, str, str]]:
+    a, b = run(x, old), run(x, name)
+    if a[0] != b[0]:
+        return [
+            (
+                label,
+                name,
+                "run",
+                f"old {a[0]} {a[1] if a[0] == 'err' else ''} / new {b[0]} {b[1] if b[0] == 'err' else ''}",
+            )
+        ]
+    if a[0] == "err":
+        return (
+            []
+            if a[1].split(":")[0] == b[1].split(":")[0]
+            else [(label, name, "error", f"{a[1]} | {b[1]}")]
+        )
+    diffs = []
+    for el in ELEMENTS:
+        r = same(a[1].get(el), b[1].get(el))
+        if r is not None:
+            diffs.append((label, name, el, r))
+    return diffs
+
+
+def main() -> dict:
+    ins, dup = inputs()
+    diffs = []
+    n = 0
+    for label, x in ins:
+        for name, old in MODULES.items():
+            n += 1
+            diffs += compare(label, x, name, old)
+    # chains: the summary merge on dicts against DataFrame.merge, with a clashing column
+    chains = 0
+    for label, x in ins[:3] + ins[-2:]:
+        for first in ("ethics_check", "open_practices"):
+            for second in MODULES:
+                chains += 1
+                try:
+                    a = module_run(module_run(copy.deepcopy(x), MODULES[first]), MODULES[second])
+                    b = module_run(module_run(copy.deepcopy(x), first), second)
+                except Exception:
+                    diffs.append(
+                        (label, f"{first}>{second}", "chain", traceback.format_exc()[-300:])
+                    )
+                    continue
+                r = same(a.summary_table, b.summary_table)
+                if r is not None:
+                    diffs.append((label, f"{first}>{second}", "summary_table", r))
+            # the same module twice: every column clashes and gets the suffix
+            a = module_run(module_run(copy.deepcopy(x), MODULES[first]), MODULES[first])
+            b = module_run(module_run(copy.deepcopy(x), first), first)
+            chains += 1
+            r = same(a.summary_table, b.summary_table)
+            if r is not None:
+                diffs.append((label, f"{first}x2", "summary_table", r))
+    # the duplicate-id list: expected to differ (U-entry), quantified
+    dup_rows = {}
+    for name, old in MODULES.items():
+        a, b = run(dup[1], old), run(dup[1], name)
+        dup_rows[name] = {
+            "old": a[1]
+            if a[0] == "err"
+            else {
+                "table_rows": len(a[1].table),
+                "summary_rows": len(a[1].summary_table),
+                "traffic_light": a[1].traffic_light,
+                "summary_text": a[1].summary_text,
+            },
+            "new": b[1]
+            if b[0] == "err"
+            else {
+                "table_rows": len(b[1].table),
+                "summary_rows": len(b[1].summary_table),
+                "traffic_light": b[1].traffic_light,
+                "summary_text": b[1].summary_text,
+            },
+            "differs": [
+                el
+                for el in ELEMENTS
+                if a[0] == "ok" and b[0] == "ok" and same(a[1].get(el), b[1].get(el))
+            ],
+        }
+    return {
+        "inputs": len(ins),
+        "module_runs": n,
+        "elements": n * len(ELEMENTS),
+        "chains": chains,
+        "differences": len(diffs),
+        "first": [list(d) for d in diffs[:30]],
+        "dup_id_list": dup_rows,
+    }
+
+
+if __name__ == "__main__":
+    out = main()
+    print(json.dumps(out, indent=1, default=str))
+    if "--json" in sys.argv:
+        json.dump(out, open(sys.argv[sys.argv.index("--json") + 1], "w"), indent=1, default=str)
