+"""The indexed-document core (ARCHITECTURE.md section 2): Doc, patterns, hits, output.
+
+Layering: ``core`` imports only ``_r``, ``_values``, ``papers.model`` and
+``papers.schema`` (plus lazily the legacy frame builder for odd papers); the
+façades (``text.search``...) import the core, never the reverse.
+"""
diff --git a/src/pytacheck/core/doc.py b/src/pytacheck/core/doc.py
new file mode 100644
index 0000000..8425fe1
--- /dev/null
+++ b/src/pytacheck/core/doc.py
@@ -0,0 +1,702 @@
+"""``Doc``: one paper, indexed once; ``Docs``: the papers of a module input.
+
+A Doc holds the sentence table ``text_search()`` searches (the text table with
+each sentence's section ``header`` and ``section_type``) as column lists, and
+builds everything else lazily: the cleaned text of each chain stage, the
+casefolded text, the literal index, and per-(pattern, stage) masks as
+``(known, true)`` int bitsets, evaluated only on the rows a chain asks about.
+
+Two backings give the same rows, columns and dtypes as the legacy frame
+(``text/search.py:_text_frame``, invariant V4):
+
+* **records**: a paper whose text and section tables are still the reader's
+  JSON records (every corpus paper). Sections are joined through a dict; each
+  column's dtype is decided once, from the full column, with the coercion
+  ``records_to_frame()`` applies; output frames are built from the hit rows only.
+* **frame**: anything else (materialised tables, odd columns, duplicate section
+  ids, DataFrame and character inputs of the façade): the legacy frame, sliced.
+
+The cache lives in ``Paper._derived`` and is trusted only while the source
+tables are raw records, or inside the run context that built it (section 2.2).
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Callable, Iterable, Iterator, Mapping, Sequence
+from typing import TYPE_CHECKING, Any
+
+import pandas as pd
+
+from pytacheck._r.regex import _as_str, _compile, casefold
+from pytacheck.core.index import LiteralScan, WordIndex
+from pytacheck.core.patterns import Pat, PatternSet, as_patterns
+from pytacheck.core.run import count, current
+from pytacheck.papers.model import Paper, PaperList, is_paper_list
+from pytacheck.papers.schema import _column_types, _fast_column, coerce_column, infer_column
+
+if TYPE_CHECKING:
+    from pytacheck.core.hits import Hits
+
+__all__ = ["Doc", "Docs", "bits"]
+
+_REQUIRED = ("text", "text_id", "section_id", "paragraph_id", "paper_id", "header", "section_type")
+_MARKER = "<~p~>"
+_WS = _compile(r"\s+", False, False, False, True)  # TRE \s, as gsub("\\s+", " ", x)
+_CTRL_WS = frozenset("\t\n\v\f\r")
+#: "index" (word index) or "scan" (per-piece scans of the folded rows): spike choice (a)
+LITERALS = os.environ.get("PYTACHECK_LITERALS", "index")
+
+
+def bits(mask: int) -> Iterator[int]:
+    """The set bits of *mask*, lowest first."""
+    while mask:
+        low = mask & -mask
+        yield low.bit_length() - 1
+        mask ^= low
+
+
+def _na(v: Any) -> Any:
+    return None if v is None or v is pd.NA or (isinstance(v, float) and v != v) else v
+
+
+def clean(s: str | None, first: bool = True) -> str | None:
+    """One ``text_search()`` output cleaning: TRE ``\\s+`` -> " ", " , " -> ", ",
+    paragraph markers -> blank lines. Fast path: an ASCII sentence it would not change."""
+    if s is None:
+        return None
+    if first:
+        if (
+            s.isascii()
+            and "  " not in s
+            and " , " not in s
+            and _MARKER not in s
+            and not _CTRL_WS.intersection(s)
+        ):
+            return s
+    elif " , " not in s and "\n" not in s:
+        return s  # a cleaned string changes again only through these (section 2.2, V3)
+    return _WS.sub(" ", s).replace(" , ", ", ").replace(_MARKER, "\n\n")
+
+
+class _Column:
+    """One typed column of a records-backed Doc: values and the dtype decided once."""
+
+    __slots__ = ("dtype", "values")
+
+    def __init__(self, values: list[Any], dtype: Any) -> None:
+        self.values = values
+        self.dtype = dtype
+
+    def take(self, idx: Sequence[int]) -> pd.Series:
+        v = self.values
+        out: pd.Series = pd.Series([v[i] for i in idx], dtype=self.dtype)
+        return out
+
+
+def _typed(table: str, records: list[dict[str, Any]], col: str) -> _Column:
+    """``records_to_frame(table, records, [col])[col]``, as values plus dtype."""
+    vals = [r.get(col) for r in records]
+    typ = _column_types(table).get(col)
+    if typ in ("array", "object"):
+        return _Column(vals, object)
+    fast = _fast_column(vals, typ)
+    if fast is not None and typ is not None:
+        return _Column(vals, fast.dtype)
+    if typ is None:
+        series = fast if fast is not None else infer_column(vals)
+    else:
+        series = coerce_column(infer_column(vals), typ)
+    return _Column([_na(v) if series.dtype != object else v for v in series.tolist()], series.dtype)
+
+
+def _is_int_key(col: _Column) -> bool:
+    return isinstance(col.dtype, pd.Int64Dtype)
+
+
+class Doc:
+    """One paper (or one table of sentences), indexed. Read-only once built."""
+
+    paper_id: Any
+    n: int
+    columns: list[str]
+    text: list[str | None]  # the stage-0 field: raw text (``text_search()``'s match field)
+    header: list[str | None]
+    section_type: list[Any]
+    text_id: list[Any]
+    pids: list[Any] | None  # per-row paper ids of a multi-paper table; None: all paper_id
+    all: int
+    body: int  # rows outside the references: text_search()'s exclusion
+    missing: list[str]  # required columns the source lacked (text_search() adds them)
+
+    __slots__ = (
+        "_base",
+        "_cols",
+        "_expanded",
+        "_facets",
+        "_fold",
+        "_frame",
+        "_hdr_groups",
+        "_hdr_state",
+        "_lit",
+        "_litmode",
+        "_stages",
+        "_state",
+        "all",
+        "body",
+        "columns",
+        "header",
+        "missing",
+        "n",
+        "paper_id",
+        "pids",
+        "section_type",
+        "text",
+        "text_id",
+    )
+
+    def __init__(self) -> None:
+        self._stages: list[list[str | None]] = []
+        self._fold: list[str] | None = None
+        self._lit: Any = None
+        self._litmode = LITERALS
+        self._state: dict[tuple[Pat, int], tuple[int, int]] = {}
+        self._hdr_state: dict[Pat, int] = {}
+        self._hdr_groups: dict[str, int] | None = None
+        self._facets: dict[str, Any] = {}
+        self._expanded: dict[Any, Any] | None = None
+        self._frame: pd.DataFrame | None = None
+        self._base: pd.DataFrame | None = None
+        self._cols: dict[str, _Column] | None = None
+        self.missing: list[str] = []
+
+    # -- construction ---------------------------------------------------------------
+
+    @classmethod
+    def of(cls, paper: Paper) -> Doc:
+        """The paper's Doc, from its cache when that may be trusted (section 2.2)."""
+        deps = _deps(paper)
+        derived = _derived(paper)
+        ctx = current()
+        hit = derived.get("doc")
+        if hit is not None:
+            gen, hdeps, token, doc = hit
+            if (
+                gen == paper._generation
+                and len(hdeps) == len(deps)
+                and all(a is b for a, b in zip(hdeps, deps, strict=True))
+                and (_all_raw(deps) or (token is not None and token is ctx))
+            ):
+                return doc  # type: ignore[no-any-return]
+        doc = cls._records(paper) or cls._fallback(paper)
+        count("doc_builds")
+        derived["doc"] = (paper._generation, deps, ctx, doc)
+        if ctx is not None and ctx.explicit:
+            ctx.watch(f"paper {paper.paper_id!r}", lambda: _fingerprint(paper))
+        return doc
+
+    @classmethod
+    def _records(cls, paper: Paper) -> Doc | None:
+        """The records backing, or ``None`` when the paper needs the legacy frame."""
+        traw = paper._raw_records("text")
+        sraw = paper._raw_records("section")
+        if traw is None or sraw is None:
+            return None
+        recs, tcols = traw
+        srecs, scols = sraw
+        if (
+            any(c not in tcols for c in ("text", "text_id", "paragraph_id", "section_id"))
+            or any(c in tcols for c in ("header", "section_type", "paper_id"))
+            or any(c not in scols for c in ("section_id", "header", "section_type"))
+            or len(set(tcols)) != len(tcols)
+        ):
+            return None
+        cols = {c: _typed("text", recs, c) for c in tcols}
+        skey = _typed("section", srecs, "section_id")
+        if not _is_int_key(cols["section_id"]) or not _is_int_key(skey):
+            return None
+        row_of: dict[Any, int] = {}
+        for j, k in enumerate(skey.values):
+            if k in row_of:
+                return None  # the merge would repeat sentences
+            row_of[k] = j
+        header = _typed("section", srecs, "header")
+        stype = _typed("section", srecs, "section_type")
+        if header.dtype != "string" or stype.dtype != "string":
+            return None
+        rows = [row_of.get(k, -1) for k in cols["section_id"].values]
+        d = cls()
+        d.paper_id = paper.paper_id
+        d.n = len(recs)
+        d.columns = [*tcols, "paper_id", "header", "section_type"]
+        d._cols = cols
+        tv = cols["text"].values
+        d.text = [_as_str(v) for v in tv] if cols["text"].dtype != "string" else list(tv)
+        d.header = [None if j < 0 else header.values[j] for j in rows]
+        d.section_type = [None if j < 0 else stype.values[j] for j in rows]
+        d.text_id = list(cols["text_id"].values)
+        d.pids = None
+        d._finish()
+        return d
+
+    @classmethod
+    def _fallback(cls, paper: Paper) -> Doc:
+        from pytacheck.text.search import _legacy_text_frame
+
+        frame, _ = _legacy_text_frame(paper)
+        d = cls.from_frame(frame)
+        d.paper_id = paper.paper_id
+        return d
+
+    @classmethod
+    def from_frame(cls, frame: pd.DataFrame) -> Doc:
+        """A table of sentences (a chained result, a user table, a paper list's frame)."""
+        d = cls()
+        d._litmode = "scan"  # a one-off table: an index would not pay for itself
+        d._base = frame
+        missing = [c for c in _REQUIRED if c not in frame.columns]
+        if missing:
+            frame = frame.copy(deep=False)
+            for m in missing:
+                frame[m] = pd.Series([pd.NA] * len(frame), index=frame.index, dtype=object)
+            if "text" in missing:
+                frame["text"] = frame.iloc[:, 0]
+        d.missing = missing
+        d._frame = frame
+        d.n = len(frame)
+        d.columns = list(frame.columns)
+        d.text = [_as_str(v) for v in frame["text"].tolist()]
+        d.header = [_as_str(v) for v in frame["header"].tolist()]
+        d.section_type = [_na(v) for v in frame["section_type"].tolist()]
+        d.text_id = [_na(v) for v in frame["text_id"].tolist()]
+        d.pids = [_na(v) for v in frame["paper_id"].tolist()]
+        pids = set(d.pids)
+        d.paper_id = next(iter(pids)) if len(pids) == 1 else None
+        d._finish()
+        return d
+
+    @classmethod
+    def from_strings(cls, xs: Sequence[str]) -> Doc:
+        return cls.from_frame(pd.DataFrame({"text": pd.Series(list(xs), dtype="string")}))
+
+    def _finish(self) -> None:
+        self.all = (1 << self.n) - 1
+        body = 0
+        for i, t in enumerate(self.section_type):
+            if not (isinstance(t, str) and t == "references"):
+                body |= 1 << i
+        self.body = body
+
+    # -- fields ------------------------------------------------------------------------
+
+    def field(self, stage: int) -> list[str | None]:
+        """The text a stage matches: raw (0), or cleaned *stage* times."""
+        if stage == 0:
+            return self.text
+        st = self._stages
+        while len(st) < stage:
+            first = not st
+            prev = self.text if first else st[-1]
+            st.append([clean(s, first) for s in prev])
+        return st[stage - 1]
+
+    def fold(self) -> list[str]:
+        if self._fold is None:
+            self._fold = [
+                "" if s is None else s.lower() if s.isascii() else casefold(s) for s in self.text
+            ]
+        return self._fold
+
+    def _literal_rows(self, piece: str) -> int:
+        lit = self._lit
+        if lit is None:
+            lit = self._lit = (WordIndex if self._litmode == "index" else LiteralScan)(self.fold())
+        return lit.rows(piece)  # type: ignore[no-any-return]
+
+    def candidates(self, p: Pat) -> int | None:
+        """Rows that can match *p* (``None``: no literal is known)."""
+        cnf = p.literals()
+        if not cnf:
+            return None
+        out = self.all
+        for clause in cnf:
+            rows = 0
+            for piece in clause:
+                rows |= self._literal_rows(piece)
+            out &= rows
+            if not out:
+                break
+        return out
+
+    # -- masks -------------------------------------------------------------------------
+
+    def mask(self, p: Pat, stage: int = 0, within: int | None = None) -> int:
+        """Rows of *within* (default: the body) whose stage text matches *p*."""
+        want = self.body if within is None else within
+        if not want:
+            return 0
+        key = (p, stage)
+        known, true = self._state.get(key, (0, 0))
+        todo = want & ~known
+        if todo:
+            ev = todo
+            cand = self.candidates(p)
+            if cand is not None:
+                ev &= cand
+            hits = 0
+            if ev:
+                texts = self.field(stage)
+                det = p.detector()
+                for i in bits(ev):
+                    s = texts[i]
+                    if s is not None and det(s):
+                        hits |= 1 << i
+            true |= hits
+            self._state[key] = (known | todo, true)
+        return true & want
+
+    def header_mask(self, p: Pat, within: int) -> int:
+        """Rows of *within* whose section header matches *p* (each header tested once)."""
+        rows = self._hdr_state.get(p)
+        if rows is None:
+            groups = self._hdr_groups
+            if groups is None:
+                groups = {}
+                for i, h in enumerate(self.header):
+                    if h is not None:
+                        groups[h] = groups.get(h, 0) | (1 << i)
+                self._hdr_groups = groups
+            det = p.detector()
+            rows = 0
+            for h, r in groups.items():
+                if det(h):
+                    rows |= r
+            self._hdr_state[p] = rows
+        return rows & within
+
+    def any(
+        self,
+        ps: Pat | PatternSet,
+        stage: int = 0,
+        within: int | None = None,
+        header: bool = False,
+        rank: dict[int, int] | None = None,
+    ) -> int:
+        """Rows matching any pattern, each pattern only on rows no earlier one matched.
+
+        With *rank*, records for each row the index of the first pattern that matched
+        (the pattern-major order of ``text_search()`` over a pattern list).
+        """
+        rest = self.body if within is None else within
+        out = 0
+        for k, p in enumerate(as_patterns(ps)):
+            if not rest:
+                break
+            m = self.mask(p, stage, rest)
+            if header:
+                m |= self.header_mask(p, rest)
+            if m:
+                if rank is not None:
+                    for i in bits(m):
+                        rank[i] = k
+                out |= m
+                rest &= ~m
+        return out
+
+    def find(self, p: Pat, within: int | None = None, stage: int = 0) -> list[tuple[int, str]]:
+        """``(row, match)`` for every match R's ``gregexpr()`` finds, in row then text order."""
+        from pytacheck._r.regex import regextract_all
+
+        rows = list(bits(self.mask(p, stage, within)))
+        texts = self.field(stage)
+        found = regextract_all(p.src, [texts[i] for i in rows], p.icase, p.perl, p.fixed)
+        return [(i, m) for i, ms in zip(rows, found, strict=True) for m in ms]
+
+    # -- projection --------------------------------------------------------------------
+
+    def rows(
+        self,
+        idx: Sequence[int],
+        stage: int = 1,
+        text: Sequence[Any] | None = None,
+        force_text: bool = False,
+    ) -> pd.DataFrame:
+        """The sentence-table rows *idx*, text at *stage* (or *text*), as ``text_search()``
+        returns them (an empty selection keeps the source's column types)."""
+        if text is None and idx:
+            text = self._stage_text(idx, stage)
+        if self._cols is None:
+            assert self._frame is not None
+            if not idx and not force_text:
+                return self._frame.iloc[0:0].reset_index(drop=True)
+            out = self._frame.take(list(idx)).reset_index(drop=True)
+            out["text"] = pd.Series(list(text or []), index=out.index, dtype="string")
+            return out
+        cols = self._cols
+        if text is None:
+            text = []
+        data: dict[str, pd.Series] = {}
+        k = len(idx)
+        for c in self.columns:
+            if c == "text":
+                data[c] = pd.Series(list(text), dtype="string")
+            elif c == "paper_id":
+                data[c] = pd.Series([self.paper_id] * k, dtype="string")
+            elif c == "header":
+                data[c] = pd.Series([self.header[i] for i in idx], dtype="string")
+            elif c == "section_type":
+                data[c] = pd.Series([self.section_type[i] for i in idx], dtype="string")
+            else:
+                data[c] = cols[c].take(idx)
+        return pd.DataFrame(data)
+
+    def _stage_text(self, idx: Sequence[int], stage: int) -> list[str | None]:
+        if stage == 1 and not self._stages:  # clean just these rows
+            t = self.text
+            return [clean(t[i]) for i in idx]
+        field = self.field(stage)
+        return [field[i] for i in idx]
+
+    def frame(self) -> pd.DataFrame:
+        """The whole sentence table (the legacy ``_text_frame``), raw text."""
+        if self._frame is None:
+            self._frame = self.rows(range(self.n), 0, self.text) if self.n else self.rows([])
+            self._base = self._frame
+        return self._frame
+
+    def base_frame(self) -> pd.DataFrame:
+        """:meth:`frame` before ``text_search()`` adds the columns it requires."""
+        if self._base is None:
+            self.frame()
+        assert self._base is not None
+        return self._base
+
+    def row_key(self, i: int, stage: int) -> tuple[Any, ...]:
+        """Every output cell of row *i* at *stage* (what ``drop_duplicates()`` compares)."""
+        if self._frame is not None and self._cols is None:
+            vals = [_na(v) for v in self._frame.iloc[i].tolist()]
+            vals[self.columns.index("text")] = self.field(stage)[i]
+            return tuple(_hashable(v) for v in vals)
+        cols = self._cols
+        assert cols is not None
+        out = []
+        for c in self.columns:
+            if c == "text":
+                out.append(self.field(stage)[i])
+            elif c == "paper_id":
+                out.append(self.paper_id)
+            elif c == "header":
+                out.append(self.header[i])
+            elif c == "section_type":
+                out.append(self.section_type[i])
+            else:
+                out.append(_hashable(_na(cols[c].values[i])))
+        return tuple(out)
+
+    def expanded(self, i: int) -> str:
+        """``text_expand(expand_to = "sentence")`` of row *i*: the cleaned sentences with
+        its (paper, section, paragraph, text) key, joined with a space."""
+        exp = self._expanded
+        if exp is None:
+            sids = self._column_values("section_id")
+            pgids = self._column_values("paragraph_id")
+            pids = self.pids or [self.paper_id] * self.n
+            keys = list(zip(pids, sids, pgids, self.text_id, strict=True))
+            groups: dict[Any, list[str | None]] = {}
+            clean1 = self.field(1)
+            for r in bits(self.body):
+                if self.text[r] is not None:  # text_search(paper) (".*") skips NA text
+                    groups.setdefault(keys[r], []).append(clean1[r])
+            exp = {k: " ".join(t or "NA" for t in v) for k, v in groups.items()}
+            exp["keys"] = keys
+            self._expanded = exp
+        return exp[exp["keys"][i]]  # type: ignore[no-any-return]
+
+    def _column_values(self, c: str) -> list[Any]:
+        if self._cols is not None:
+            return [_na(v) for v in self._cols[c].values]
+        assert self._frame is not None
+        return [_na(v) for v in self._frame[c].tolist()]
+
+    def facet(self, name: Any, build: Callable[[Doc], Any]) -> Any:
+        """A shared extractor's result, memoised on this Doc."""
+        hit = self._facets.get(name)
+        if hit is None:
+            hit = self._facets[name] = build(self)
+        return hit
+
+
+def _hashable(v: Any) -> Any:
+    if isinstance(v, list):
+        return ("list", tuple(_hashable(x) for x in v))
+    if isinstance(v, dict):
+        return ("dict", tuple(sorted((k, _hashable(x)) for k, x in v.items())))
+    return v
+
+
+# -- the cache on the paper ---------------------------------------------------------------
+
+
+def _derived(paper: Paper) -> dict[str, Any]:
+    d = getattr(paper, "_derived", None)
+    if d is None:
+        d = {}
+        object.__setattr__(paper, "_derived", d)
+    return d
+
+
+def _deps(paper: Paper) -> tuple[Any, ...]:
+    """What the Doc is built from: each source table's raw records or table object."""
+    out: list[Any] = [paper.paper_id]
+    for name in ("text", "section"):
+        raw = paper._raw_records(name)
+        if raw is not None:
+            out += [_RAW, raw[0], raw[1]]
+        else:
+            out += [paper._tables.get(name)]
+    return tuple(out)
+
+
+class _RawMarker:
+    pass
+
+
+_RAW = _RawMarker()
+
+
+def _all_raw(deps: tuple[Any, ...]) -> bool:
+    """Whether text and section are raw records (which no caller edits in place)."""
+    return deps[1] is _RAW and deps[4] is _RAW
+
+
+def _fingerprint(paper: Paper) -> Any:
+    out: list[tuple[Any, ...]] = []
+    for name in ("text", "section", "bib", "xref"):
+        raw = paper._raw_records(name)
+        if raw is not None:
+            out.append(("raw", id(raw[0]), len(raw[0])))
+            continue
+        t = paper._tables.get(name)
+        if isinstance(t, pd.DataFrame):
+            try:
+                h = int(pd.util.hash_pandas_object(t, index=True).sum())
+            except TypeError:
+                h = hash(repr(t.values.tolist()))
+            out.append((name, tuple(t.columns), h))
+        else:
+            out.append((name, id(t)))
+    return tuple(out)
+
+
+# -- Docs --------------------------------------------------------------------------------
+
+
+class Docs:
+    """The module input as Docs: a paper gives one, a paper list its papers' in order."""
+
+    __slots__ = ("docs", "papers")
+
+    def __init__(self, papers: Sequence[Paper]) -> None:
+        self.papers = tuple(papers)
+        self.docs = tuple(Doc.of(p) for p in self.papers)
+
+    @classmethod
+    def of(cls, paper: Any) -> Docs:
+        if isinstance(paper, Paper):
+            return cls([paper])
+        if isinstance(paper, PaperList) or (is_paper_list(paper) and not isinstance(paper, str)):
+            return cls(list(paper.values()) if isinstance(paper, Mapping) else list(paper))
+        raise TypeError("paper must be a paper or paperlist object.")
+
+    def __len__(self) -> int:
+        return len(self.docs)
+
+    def __iter__(self) -> Iterator[Doc]:
+        return iter(self.docs)
+
+    def __getitem__(self, i: int) -> Doc:
+        return self.docs[i]
+
+    def info_ids(self) -> list[str]:
+        """``paper_id(paper)``: each paper's id once per ``info`` row, in list order."""
+        out: list[str] = []
+        for p in self.papers:
+            out.extend(_info_ids(p))
+        return out
+
+    def paper_ids(self) -> list[str]:
+        """R's ``paper_id(paper)`` rule, deduplicated: info ids, else the paper's own id."""
+        ids: list[str] = []
+        for p in self.papers:
+            own = _info_ids(p)
+            if not own and isinstance(p.paper_id, str):
+                own = [p.paper_id]
+            ids.extend(own)
+        return list(dict.fromkeys(ids))
+
+    def template(self) -> pd.DataFrame | None:
+        """The empty sentence table of the whole list, when its papers' columns differ.
+
+        R builds one table for a paper list: the union of the papers' text columns in
+        first-seen order (``paper_id`` after the first paper's), then ``header`` and
+        ``section_type``, then the columns ``text_search()`` requires, typed by the first
+        paper that has each. ``None`` when every Doc has the same columns.
+        """
+        if len({tuple(d.columns) for d in self.docs}) <= 1:
+            return None
+        from pytacheck._r.frames import bind_rows
+
+        order: dict[str, None] = {}
+        merged = False
+        for d in self.docs:
+            cols = list(d.base_frame().columns)
+            if cols[-2:] == ["header", "section_type"]:
+                cols, merged = cols[:-2], True
+            order.update(dict.fromkeys(cols))
+        if merged:
+            order.update(dict.fromkeys(["header", "section_type"]))
+        frame = bind_rows([d.base_frame().iloc[0:0] for d in self.docs])
+        frame = frame.loc[:, [c for c in order if c in frame.columns]]
+        for m in _REQUIRED:
+            if m not in frame.columns:
+                frame[m] = pd.Series([], dtype=object)
+        return frame.reset_index(drop=True)
+
+    def hits(
+        self, ps: Pat | PatternSet, *, include_refs: bool = False, header: bool = False
+    ) -> Hits:
+        """Stage 1: rows whose raw text (or header) matches any of *ps*."""
+        from pytacheck.core.hits import Hits as _Hits
+
+        ranks = []
+        masks = []
+        for d in self.docs:
+            rank: dict[int, int] = {}
+            if "text" in d.missing:  # a text table without text has no sentences (U102)
+                masks.append(0)
+            else:
+                masks.append(d.any(ps, 0, d.all if include_refs else d.body, header, rank))
+            ranks.append(rank)
+        return _Hits(self, tuple(masks), 1, tuple(ranks))
+
+
+def _info_ids(p: Paper) -> list[str]:
+    raw = p._raw_records("info")
+    if raw is not None:
+        n = len(raw[0])
+    elif "info" in p:
+        x = p.get("info")
+        n = len(x) if isinstance(x, pd.DataFrame) else 0
+    else:
+        n = 0
+    if not n:
+        return []
+    pid = p.paper_id
+    label = "<NA>" if pid is None else str(pd.Series([pid], dtype="string").iloc[0])
+    return [label] * n
+
+
+def iter_rows(masks: Iterable[int]) -> Iterator[tuple[int, int]]:
+    for k, m in enumerate(masks):
+        for i in bits(m):
+            yield k, i
