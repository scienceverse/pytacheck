+# Comparison operators recognised by extract_p_values() / extract_eq():
+# = < > ~ ≈ ≠ ≤ ≥ ≪ ≫
+_OPERATORS = ("=", "<", ">", "~", "≈", "≠", "≤", "≥", "≪", "≫")
+_OPS = "".join(_OPERATORS)
