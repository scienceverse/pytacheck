@@ -0,0 +1,227 @@
+"""``RefIndex``: a paper's references and citations, built once per paper.
+
+The records ``ref_table()`` returns for one paper (bib, with a ``bib_match`` DOI
+overriding the printed one, joined to the reference text), the paper's
+citations of references (``xref_type == "bibr"``; bibr 12.x papers: ``"bib"``
+with the ``target_id``), and its sentences by ``text_id``. Joins are dict
+lookups, per paper, with R's semantics (NA keys match NA keys, repeated keys
+repeat rows).
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+from dataclasses import dataclass
+from typing import Any
+
+import pandas as pd
+
+from pytacheck.core.doc import _Column, _derived, _na, _typed
+from pytacheck.core.run import current
+from pytacheck.papers.model import Paper
+
+__all__ = ["Citation", "Ref", "RefIndex", "list_refs", "ref_index"]
+
+
+@dataclass(frozen=True, slots=True)
+class Ref:
+    bib_id: Any
+    doi: str | None
+    text: str | None  # the printed reference, through its text_id
+
+
+@dataclass(frozen=True, slots=True)
+class Citation:
+    bib_id: Any
+    contents: str | None
+    text_id: Any
+
+
+class RefIndex:
+    """One paper's references, citations and sentences.
+
+    ``orig`` are the bib rows a ``bib_match`` row does not override and ``matched``
+    the ``bib_match`` rows, each ``(bib_id, doi)``; ``ref_text`` maps a bib_id to its
+    printed reference(s). :meth:`refs` is ``ref_table()`` of this paper; for a paper
+    list, :func:`list_refs` applies ``ref_table()``'s sort over the whole list.
+    """
+
+    __slots__ = ("cites", "joinable", "keys", "matched", "orig", "ref_text", "texts")
+
+    def __init__(
+        self,
+        orig: list[tuple[Any, Any]],
+        matched: list[tuple[Any, Any]],
+        ref_text: dict[Any, list[Any]],
+        cites: list[Citation],
+        texts: dict[Any, list[Any]],
+        keys: dict[str, _Column],
+        joinable: tuple[bool, bool] = (True, True),
+    ) -> None:
+        self.joinable = joinable  # whether the bib and text tables have a text_id column
+        self.orig = orig
+        self.matched = matched
+        self.ref_text = ref_text
+        self.cites = cites
+        self.texts = texts
+        #: typed columns behind the joins, for dplyr's key type rules and output dtypes:
+        #: ``bib_id`` (references), ``xref_id`` (citations), ``xref_text_id``,
+        #: ``text_id`` (sentences), ``contents`` and ``text``
+        self.keys = keys
+
+    def refs(self) -> list[Ref]:
+        rows = self.orig + self.matched
+        if self.matched:
+            rows = sorted(rows, key=lambda r: _sort_key(r[0]))  # stable, NA last
+        return [Ref(bid, doi, v) for bid, doi in rows for v in self.ref_text.get(bid, ())]
+
+
+def list_refs(indexes: Sequence[tuple[Any, RefIndex]]) -> list[tuple[Any, RefIndex, Ref]]:
+    """``ref_table()`` of a paper list: ``(paper_id, index, ref)`` in its row order.
+
+    When any paper has ``bib_match`` rows, R sorts the whole list's rows by
+    ``paper_id`` and ``bib_id`` (stable, NA last): unmatched bib rows of every paper
+    first, then every ``bib_match`` row.
+    """
+    seq = [(pid, ix, r) for pid, ix in indexes for r in ix.orig]
+    if any(ix.matched for _, ix in indexes):
+        seq += [(pid, ix, r) for pid, ix in indexes for r in ix.matched]
+        seq.sort(key=lambda e: (_sort_key(e[0]), _sort_key(e[2][0])))
+    return [(pid, ix, Ref(r[0], r[1], v)) for pid, ix, r in seq for v in ix.ref_text.get(r[0], ())]
+
+
+def _columns(paper: Paper, name: str, cols: Sequence[str] | None = None) -> dict[str, _Column]:
+    """Typed columns of one table (the columns ``paper_table()`` would give), by name."""
+    raw = paper._raw_records(name)
+    if raw is not None:
+        recs, own = raw
+        return {c: _typed(name, recs, c) for c in own if cols is None or c in cols}
+    table = paper.get(name)
+    if not isinstance(table, pd.DataFrame):
+        return {}
+    return {
+        c: _Column([_na(v) for v in table[c].tolist()], table[c].dtype)
+        for c in table.columns
+        if (cols is None or c in cols) and c != "paper_id"
+    }
+
+
+def _nrows(cols: dict[str, _Column]) -> int:
+    return len(next(iter(cols.values())).values) if cols else 0
+
+
+def _sort_key(v: Any) -> tuple[int, Any]:
+    return (1, 0) if v is None else (0, v)
+
+
+def ref_index(paper: Paper, v12: bool) -> RefIndex:
+    """The paper's RefIndex, cached while its tables are unchanged (section 2.2's rule)."""
+    deps: list[Any] = [paper.paper_id, v12]
+    raw_all = True
+    for name in ("bib", "bib_match", "xref", "text"):
+        raw = paper._raw_records(name)
+        if raw is not None:
+            deps += [raw[0], raw[1]]
+        else:
+            deps.append(paper._tables.get(name))
+            raw_all = raw_all and name not in paper._tables
+    derived = _derived(paper)
+    ctx = current()
+    hit = derived.get("refs")
+    if hit is not None:
+        gen, hdeps, token, index = hit
+        if (
+            gen == paper._generation
+            and len(hdeps) == len(deps)
+            and all(a is b for a, b in zip(hdeps, deps, strict=True))
+            and (raw_all or (token is not None and token is ctx))
+        ):
+            return index  # type: ignore[no-any-return]
+    index = _build(paper, v12)
+    derived["refs"] = (paper._generation, tuple(deps), ctx, index)
+    return index
+
+
+def _build(paper: Paper, v12: bool) -> RefIndex:
+    bib = _columns(paper, "bib", ["bib_id", "text_id", "doi"])
+    match = _columns(paper, "bib_match", ["bib_id", "doi"])
+    text = _columns(paper, "text", ["text_id", "text"])
+    xref = _columns(paper, "xref", ["xref_id", "target_id", "xref_type", "contents", "text_id"])
+
+    # R's inner_join(bib, text, by = c("paper_id", "text_id")) needs text_id in the
+    # tables of the whole list (the caller checks): a paper without it has no references
+    joinable = ("text_id" in bib, "text_id" in text)
+    if not joinable[0]:
+        bib["text_id"] = _Column([None] * _nrows(bib), "Int64")
+    if not joinable[1]:
+        text["text_id"] = _Column([None] * _nrows(text), "Int64")
+
+    nb = _nrows(bib)
+    bib_ids = bib["bib_id"].values if "bib_id" in bib else [None] * nb
+    dois = bib["doi"].values if "doi" in bib else [None] * nb
+    orig = [(bib_ids[i], dois[i]) for i in range(nb)]
+    bib_dtype = bib["bib_id"].dtype if "bib_id" in bib else object
+    nm = _nrows(match)
+    overridden: list[tuple[Any, Any]] = []
+    if nm:
+        m_ids = match["bib_id"].values
+        m_dois = match["doi"].values if "doi" in match else [None] * nm
+        ids_matched = set(m_ids)
+        orig = [r for r in orig if r[0] not in ids_matched]
+        overridden = list(zip(m_ids, m_dois, strict=True))
+
+    # sentences by text_id (all rows, references included), raw text
+    tids = text["text_id"].values
+    tvals = text["text"].values if "text" in text else [None] * len(tids)
+    texts: dict[Any, list[Any]] = {}
+    for t, v in zip(tids, tvals, strict=True):
+        texts.setdefault(t, []).append(v)
+
+    # ref_text: each bib row's reference text(s), by bib_id
+    ref_text: dict[Any, list[Any]] = {}
+    b_tids = bib["text_id"].values
+    for bid, t in zip(bib_ids, b_tids, strict=True):
+        for v in texts.get(t, ()):
+            ref_text.setdefault(bid, []).append(v)
+
+    # citations of references
+    cites: list[Citation] = []
+    nx = _nrows(xref)
+    if nx:
+        types = xref["xref_type"].values if "xref_type" in xref else [None] * nx
+        ids = (xref["target_id"] if v12 else xref["xref_id"]).values
+        contents = xref["contents"].values if "contents" in xref else [None] * nx
+        x_tids = xref["text_id"].values if "text_id" in xref else [None] * nx
+        want = "bib" if v12 else "bibr"
+        cites = [Citation(ids[i], contents[i], x_tids[i]) for i in range(nx) if types[i] == want]
+
+    def col(
+        cols: dict[str, _Column], name: str, dtype: Any, rows: Sequence[int] | None = None
+    ) -> _Column:
+        c = cols.get(name)
+        if c is None:
+            return _Column([], dtype)
+        return c if rows is None else _Column([c.values[i] for i in rows], c.dtype)
+
+    bib_col = _Column([r[0] for r in orig + overridden], bib_dtype)
+    if nm and bib_dtype != match["bib_id"].dtype:
+        bib_col = _Column(bib_col.values, _concat_dtype(bib_dtype, match["bib_id"].dtype))
+    xrows = None
+    if nx:
+        want_t = "bib" if v12 else "bibr"
+        types = xref["xref_type"].values if "xref_type" in xref else [None] * nx
+        xrows = [i for i in range(nx) if types[i] == want_t]
+    keys = {
+        "bib_id": bib_col,
+        "xref_id": col(xref, "target_id" if v12 else "xref_id", "Int64", xrows),
+        "xref_text_id": col(xref, "text_id", "Int64", xrows),
+        "text_id": col(text, "text_id", "Int64"),
+        "contents": col(xref, "contents", "string"),
+        "text": col(text, "text", "string"),
+    }
+    return RefIndex(orig, overridden, ref_text, cites, texts, keys, joinable)
+
+
+def _concat_dtype(a: Any, b: Any) -> Any:
+    """The dtype ``bind_rows()`` gives two non-empty parts of these dtypes."""
+    return pd.concat([pd.Series([], dtype=a), pd.Series([], dtype=b)]).dtype
