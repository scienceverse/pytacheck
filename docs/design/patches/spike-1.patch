+    r"\bceea\b",
+    # approval phrasing
+    r"ethics\s+(approval|clearance)\s+(was\s+)?(granted|obtained|received|given|secured)",
+    r"ethics\s+(approval|clearance)",
+    r"ethical\s+(approval|clearance)\s+(was\s+)?(granted|obtained|received|given|secured)",
