@@ -0,0 +1,47 @@
+"""Lines of code, old against new: total lines, and logic lines (non-blank, non-comment
+lines inside function bodies, docstrings excluded)."""
+
+from __future__ import annotations
+
+import ast
+import io
+import json
+import sys
+import tokenize
+
+
+def logic_lines(path: str) -> int:
+    src = open(path).read()
+    tree = ast.parse(src)
+    doc: set[int] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Module)):
+            body = node.body
+            if body and isinstance(body[0], ast.Expr) and isinstance(getattr(body[0], "value", None), ast.Constant) and isinstance(body[0].value.value, str):
+                doc.update(range(body[0].lineno, body[0].end_lineno + 1))
+    code: set[int] = set()
+    for tok in tokenize.generate_tokens(io.StringIO(src).readline):
+        if tok.type in (tokenize.COMMENT, tokenize.NL, tokenize.NEWLINE, tokenize.INDENT, tokenize.DEDENT, tokenize.ENDMARKER):
+            continue
+        for ln in range(tok.start[0], tok.end[0] + 1):
+            code.add(ln)
+    inside: set[int] = set()
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and node.col_offset == 0 or isinstance(node, ast.ClassDef) and node.col_offset == 0:
+            inside.update(range(node.body[0].lineno, node.end_lineno + 1))
+    return len((code & inside) - doc)
+
+
+def total(path: str) -> int:
+    return sum(1 for _ in open(path))
+
+
+if __name__ == "__main__":
+    pairs = json.loads(sys.argv[1])
+    out = {}
+    for name, (old, new) in pairs.items():
+        out[name] = {
+            "old_lines": sum(total(p) for p in old), "new_lines": sum(total(p) for p in new),
+            "old_logic": sum(logic_lines(p) for p in old), "new_logic": sum(logic_lines(p) for p in new),
+        }
+    print(json.dumps(out, indent=1))
