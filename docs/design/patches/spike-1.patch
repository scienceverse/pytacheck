--- /dev/null
+++ b/spike/cmp_reports.py
@@ -0,0 +1,18 @@
+"""Compare two parity check reports: every case whose status differs."""
+import json, sys
+def load(p):
+    return {c["case"]: c for c in json.load(open(p))}
+b, t = load(sys.argv[1]), load(sys.argv[2])
+only = sys.argv[3:] 
+diff = []
+for k in sorted(set(b) | set(t)):
+    if only and not any(k.startswith(o + "/") for o in only):
+        continue
+    sb, st = b.get(k, {}).get("status"), t.get(k, {}).get("status")
+    if sb != st:
+        diff.append((k, sb, st, t.get(k, {}).get("tier"), t.get(k, {}).get("problems", [])[:3]))
+print(f"{len(b)} vs {len(t)} cases; {len(diff)} status changes")
+for d in diff:
+    print(d[0], d[1], "->", d[2], "tier", d[3])
+    for p in d[4]:
+        print("    ", str(p)[:300])
diff --git a/spike/diff_paper_id.py b/spike/diff_paper_id.py
new file mode 100644
index 0000000..9b57024
--- /dev/null
+++ b/spike/diff_paper_id.py
@@ -0,0 +1,127 @@
+"""Differential test: paper_id() fast path (P4) against perf base's paper_id()."""
+
+import copy
+import os
+import sys
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+import pandas as pd
+
+import pytacheck as pc
+from parity import accuracy as A
+from parity.cases import metacheck_defaults
+from pytacheck.core.doc import Docs
+from pytacheck.papers import tables as T
+from pytacheck.papers.model import Paper, PaperList
+
+
+class L:  # the legacy paper_id() against the Doc core's info_ids()
+    paper_id = staticmethod(T.paper_id)
+
+
+def _new(x):
+    try:
+        docs = Docs.of(x)
+    except TypeError:
+        return T.paper_id(x)  # not a paper: the same error path
+    return docs.info_ids()
+
+
+class N:
+    paper_id = staticmethod(_new)
+
+
+inputs = list(dict.fromkeys(o.input for o in A.load_matrix() if o.kind == "paper"))
+papers = [pc.read(A.ROOT / i) for i in inputs]
+with metacheck_defaults():
+    papers += [pc.read(A.ROOT / i) for i in inputs if i.endswith(".xml")]
+
+
+def _fixed(q):
+    q.paper_id = "tp"
+    return q
+
+
+def run(fn, x):
+    try:
+        return ("ok", fn(x))
+    except Exception as e:
+        return ("err", f"{type(e).__name__}: {e}")
+
+
+n = 0
+bad = []
+
+
+def check(label, make):
+    global n
+    n += 1
+    a, b = run(L.paper_id, make()), run(N.paper_id, make())
+    if a != b:
+        bad.append((label, a, b))
+
+
+for i, p in enumerate(papers):
+    check(i, lambda p=p: copy.deepcopy(p))
+
+    def mat(q):
+        q.info
+        return q
+
+    check(f"{i}/mat", lambda p=p: mat(copy.deepcopy(p)))
+
+    def noinfo(q):
+        del q["info"]
+        return q
+
+    check(f"{i}/noinfo", lambda p=p: noinfo(copy.deepcopy(p)))
+
+    def two(q):
+        q["info"] = pd.concat([q.info, q.info])
+        return q
+
+    check(f"{i}/two", lambda p=p: two(copy.deepcopy(p)))
+
+    def empty(q):
+        q["info"] = q.info.iloc[0:0]
+        return q
+
+    check(f"{i}/empty", lambda p=p: empty(copy.deepcopy(p)))
+
+    def pidnone(q):
+        q.paper_id = None
+        return q
+
+    check(f"{i}/pidnone", lambda p=p: pidnone(copy.deepcopy(p)))
+
+    def nocols(q):
+        q["info"] = q.info.loc[:, []]
+        return q
+
+    check(f"{i}/nocols", lambda p=p: nocols(copy.deepcopy(p)))
+check("list", lambda: PaperList([copy.deepcopy(p) for p in papers[:5]]))
+check(
+    "mixed",
+    lambda: PaperList(
+        [noinfo(copy.deepcopy(papers[0])), copy.deepcopy(papers[1]), mat(copy.deepcopy(papers[2]))]
+    ),
+)
+check("empty-list", lambda: PaperList([]))
+check("plain-list", lambda: [copy.deepcopy(p) for p in papers[:2]])
+check("dict", lambda: {"a": copy.deepcopy(papers[0])})
+check("frame", lambda: pd.DataFrame({"x": [1]}))
+check("none", lambda: None)
+check("new-paper", lambda: Paper("x"))
+check(
+    "test-paper",
+    lambda: (
+        pc.test_paper(["a b"], paper_id="tp")
+        if "paper_id" in __import__("inspect").signature(pc.test_paper).parameters
+        else _fixed(pc.test_paper(["a b"]))
+    ),
+)
+print(f"paper_id: {n} cases, {len(bad)} differ")
+for b in bad:
+    print("DIFF", b)
