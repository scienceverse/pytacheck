+"""Differential test: text_expand() of the worktree (TS5) against perf base's."""
+
+import copy
+import os
+import sys
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+import pandas as pd  # noqa: E402
+
+import pytacheck as pc  # noqa: E402
+import tests._legacy.expand as L  # noqa: E402  (the frozen text_expand on the frozen search)
+from parity import accuracy as A  # noqa: E402
+from parity.cases import metacheck_defaults  # noqa: E402
+from pytacheck.module import module_run  # noqa: E402
+from pytacheck.text import expand as NEW  # noqa: E402
+from pytacheck.text.extract import extract_p_values  # noqa: E402
+
+inputs = list(dict.fromkeys(o.input for o in A.load_matrix() if o.kind == "paper"))
+papers = [pc.read(A.ROOT / i) for i in inputs]
+with metacheck_defaults():
+    papers += [pc.read(A.ROOT / i) for i in inputs if i.endswith(".xml")]
+n = 0
+bad = []
+
+
+def run(fn, *a, **k):
+    try:
+        return ("ok", fn(*a, **k))
+    except Exception as exc:
+        return ("err", f"{type(exc).__name__}: {exc}")
+
+
+def same(a, b):
+    if a[0] != b[0]:
+        return False
+    if a[0] == "err":
+        return a[1] == b[1]
+    x, y = a[1], b[1]
+    if list(x.columns) != list(y.columns) or list(x.dtypes) != list(y.dtypes):
+        return False
+    try:
+        pd.testing.assert_frame_equal(x, y, check_exact=True)
+    except AssertionError:
+        return False
+    return True
+
+
+def check(label, results, paper, **kw):
+    global n
+    n += 1
+    a = run(L.text_expand, results, paper, **kw)
+    b = run(NEW.text_expand, results, paper, **kw)
+    if not same(a, b):
+        bad.append((label, kw, a if a[0] == "err" else "frame", b if b[0] == "err" else "frame"))
+
+
+for i, p in enumerate(papers):
+    tables = {
+        "p_values": extract_p_values(p),
+        "search": pc.text_search(p, "the"),
+        "para": pc.text_search(p, "the", return_="paragraph"),
+        "section": pc.text_search(p, "result", return_="section"),
+        "empty": pc.text_search(p, "zzqqzz"),
+    }
+    pv = tables["p_values"]
+    if len(pv):
+        tables["float_ids"] = pv.astype({"text_id": "float64"})
+        tables["obj_pid"] = pv.astype({"paper_id": object})
+        tables["na_key"] = pv.assign(section_id=pd.array([None] * len(pv), dtype="Int64"))
+        tables["no_text"] = pv.drop(columns="text")
+        tables["no_text_id"] = pv.drop(columns="text_id")
+        tables["has_expanded"] = pv.assign(expanded="x")
+        tables["bool_ids"] = pv.assign(paragraph_id=True)
+        tables["reindexed"] = pv.set_axis(range(10, 10 + len(pv)))
+        tables["dup_rows"] = pd.concat([pv, pv])
+        tables["other_paper"] = pv.assign(paper_id="nope")
+    for name, t in tables.items():
+        for to in ("sentence", "paragraph", "div", "section"):
+            check(f"{i}/{name}", t, p, expand_to=to)
+        check(f"{i}/{name}/plus", t, p, plus=1, minus=1)
+    check(f"{i}/paper-as-results", p, p)
+    mo = module_run(copy.deepcopy(p), "marginal")
+    check(f"{i}/module-output", mo, p)
+check("bad-results", 42, papers[0])
+check("bad-expand", tables["search"], papers[0], expand_to="page")
+print(f"text_expand: {n} cases, {len(bad)} differ")
+for b in bad[:20]:
+    print("DIFF", b)
