@@ -0,0 +1,71 @@
+"""The batch-equality ``shared`` level: all 19 matrix modules on one shared paper in one run
+context give exactly what isolated runs (a fresh copy per module, no context) give.
+
+With the façade in place every unmigrated module shares the paper's Doc and masks
+with the four migrated ones, so this pins that sharing changes nothing.
+
+usage (tree root): PYTHONPATH=src:. python spike/shared.py [--json out.json]
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import os
+import sys
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+
+import pytacheck as pc  # noqa: E402
+from parity import accuracy as A  # noqa: E402
+from parity.canonical import _encode  # noqa: E402
+from pytacheck.module import module_run, run_session  # noqa: E402
+
+MODULES = A.load_matrix()
+PAPER_MODULES = list(dict.fromkeys(o.module for o in MODULES if o.kind == "paper"))
+PATHS = list(dict.fromkeys(o.input for o in MODULES if o.kind == "paper"))
+
+
+def canon(out: object) -> str:
+    if isinstance(out, str):
+        return out
+    return json.dumps(_encode(out), sort_keys=True, default=str)
+
+
+def run(p: object, m: str) -> str:
+    try:
+        return canon(module_run(p, m))
+    except Exception as exc:
+        return f"error: {type(exc).__name__}: {exc}"
+
+
+def main() -> dict:
+    diffs = []
+    n = 0
+    for path in PATHS:
+        paper = pc.read(A.ROOT / path)
+        isolated = {m: run(copy.deepcopy(paper), m) for m in PAPER_MODULES}
+        shared_paper = copy.deepcopy(paper)
+        with run_session():
+            together = {m: run(shared_paper, m) for m in PAPER_MODULES}
+        for m in PAPER_MODULES:
+            n += 1
+            if isolated[m] != together[m]:
+                diffs.append((os.path.basename(path), m))
+    return {
+        "papers": len(PATHS),
+        "modules": len(PAPER_MODULES),
+        "comparisons": n,
+        "differences": len(diffs),
+        "first": diffs[:20],
+    }
+
+
+if __name__ == "__main__":
+    out = main()
+    print(json.dumps(out, indent=1))
+    if "--json" in sys.argv:
+        json.dump(out, open(sys.argv[sys.argv.index("--json") + 1], "w"), indent=1)
+    sys.exit(1 if out["differences"] else 0)
