@@ -0,0 +1,226 @@
+"""Differential test of _text_frame(): the worktree's (P2) against perf base's.
+
+Also checks the per-paper cache: a hit returns the same table, and every change
+made through the Paper API (or a table replaced behind its back) rebuilds it.
+"""
+
+import copy
+import importlib.util
+import os
+import sys
+import warnings
+
+warnings.filterwarnings("ignore")
+sys.path.insert(0, os.getcwd())
+import pandas as pd  # noqa: E402
+
+import pytacheck as pc  # noqa: E402
+from parity import accuracy as A  # noqa: E402
+from pytacheck.papers.model import PaperList  # noqa: E402
+from pytacheck.text import search as S  # noqa: E402
+
+spec = importlib.util.spec_from_file_location("legacy_search", "tests/_legacy/search.py")
+L = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(L)
+
+inputs = list(dict.fromkeys(o.input for o in A.load_matrix() if o.kind == "paper"))
+demos = [
+    "upstream/metacheck/inst/extdata/to_err_is_human.xml",
+]
+from parity.cases import metacheck_defaults  # noqa: E402
+
+papers = [pc.read(A.ROOT / i) for i in inputs]
+with metacheck_defaults():  # the older Grobid conversion: papers holding DataFrames
+    old_papers = [pc.read(A.ROOT / i) for i in inputs if i.endswith(".xml")]
+papers += old_papers
+inputs = inputs + [i + "@metacheck" for i in inputs if i.endswith(".xml")]
+n = 0
+bad = []
+
+
+def eq(a, b):
+    try:
+        pd.testing.assert_frame_equal(a, b, check_exact=True)
+        return list(a.columns) == list(b.columns) and list(a.dtypes) == list(b.dtypes)
+    except AssertionError:
+        return False
+
+
+def run(fn, x):
+    try:
+        return ("ok", fn(x)[0])
+    except Exception as exc:
+        return ("err", f"{type(exc).__name__}: {exc}")
+
+
+def check(label, make):
+    global n
+    n += 1
+    a = run(L._text_frame, make())
+    b = run(S._text_frame, make())
+    if a[0] != b[0] or (a[0] == "err" and a[1] != b[1]) or (a[0] == "ok" and not eq(a[1], b[1])):
+        bad.append((label, a if a[0] == "err" else "frame", b if b[0] == "err" else "frame"))
+
+
+def variant(p, fn):
+    def make():
+        q = copy.deepcopy(p)
+        fn(q)
+        return q
+
+    return make
+
+
+def raw_edit(table, edit):
+    def fn(q):
+        recs, cols = q._raw_records(table)
+        recs = [dict(r) for r in recs]
+        cols = list(cols)
+        edit(recs, cols)
+        q._set_raw(table, recs, cols)
+
+    return fn
+
+
+for p, name in zip(papers, inputs, strict=True):
+    check(name, lambda p=p: copy.deepcopy(p))
+    check(name + "/materialised", variant(p, lambda q: q.text))
+    check(name + "/sec-materialised", variant(p, lambda q: q.section))
+    if p._raw_records("text") is None or p._raw_records("section") is None:
+
+        def fedit(table, edit):
+            def fn(q):
+                q[table] = edit(q[table].copy())
+
+            return fn
+
+        check(
+            name + "/f-dup-section",
+            variant(p, fedit("section", lambda d: pd.concat([d, d.iloc[:1]]))),
+        )
+        check(
+            name + "/f-na-section-id",
+            variant(
+                p,
+                fedit(
+                    "section",
+                    lambda d: d.assign(section_id=d["section_id"].where(d.index != d.index[0])),
+                ),
+            ),
+        )
+        check(
+            name + "/f-text-has-header", variant(p, fedit("text", lambda d: d.assign(header="h")))
+        )
+        check(
+            name + "/f-text-has-paper_id",
+            variant(p, fedit("text", lambda d: d.assign(paper_id="zz"))),
+        )
+        check(
+            name + "/f-float-section-id",
+            variant(p, fedit("text", lambda d: d.astype({"section_id": "float64"}))),
+        )
+        check(
+            name + "/f-no-header", variant(p, fedit("section", lambda d: d.drop(columns="header")))
+        )
+        check(name + "/f-empty-text", variant(p, fedit("text", lambda d: d.iloc[0:0])))
+        check(
+            name + "/f-reindexed",
+            variant(p, fedit("text", lambda d: d.set_axis(range(5, 5 + len(d))))),
+        )
+        check(
+            name + "/f-obj-header",
+            variant(p, fedit("section", lambda d: d.astype({"header": object}))),
+        )
+        continue
+    check(name + "/dup-section", variant(p, raw_edit("section", lambda r, c: r.append(dict(r[0])))))
+    check(
+        name + "/na-section-id",
+        variant(p, raw_edit("section", lambda r, c: r[0].update(section_id=None))),
+    )
+    check(
+        name + "/na-text-section-id",
+        variant(p, raw_edit("text", lambda r, c: [x.update(section_id=None) for x in r[:3]])),
+    )
+    check(
+        name + "/unknown-section",
+        variant(p, raw_edit("text", lambda r, c: r[0].update(section_id=99999))),
+    )
+    check(
+        name + "/text-has-header",
+        variant(p, raw_edit("text", lambda r, c: (c.append("header"), r[0].update(header="h")))),
+    )
+    check(
+        name + "/text-has-paper_id",
+        variant(
+            p,
+            raw_edit(
+                "text", lambda r, c: (c.insert(1, "paper_id"), [x.update(paper_id="zz") for x in r])
+            ),
+        ),
+    )
+    check(
+        name + "/no-header",
+        variant(
+            p,
+            raw_edit(
+                "section", lambda r, c: (c.remove("header"), [x.pop("header", None) for x in r])
+            ),
+        ),
+    )
+    check(
+        name + "/no-text-section-id",
+        variant(
+            p,
+            raw_edit(
+                "text",
+                lambda r, c: (c.remove("section_id"), [x.pop("section_id", None) for x in r]),
+            ),
+        ),
+    )
+    check(
+        name + "/str-section-id",
+        variant(
+            p,
+            raw_edit(
+                "section", lambda r, c: [x.update(section_id=str(x.get("section_id"))) for x in r]
+            ),
+        ),
+    )
+    check(
+        name + "/num-header", variant(p, raw_edit("section", lambda r, c: r[0].update(header=3.5)))
+    )
+    check(name + "/empty-text", variant(p, raw_edit("text", lambda r, c: r.clear())))
+    check(name + "/empty-section", variant(p, raw_edit("section", lambda r, c: r.clear())))
+    check(name + "/pid-none", variant(p, lambda q: setattr(q, "paper_id", None)))
+check("list", lambda: PaperList([copy.deepcopy(p) for p in papers[:4]]))
+check("empty-list", lambda: PaperList([]))
+check("plain-list", lambda: [copy.deepcopy(p) for p in papers[:2]])
+print(f"_text_frame: {n} cases, {len(bad)} differ")
+for b in bad:
+    print("DIFF", b)
+
+
+# V4 on slices: the Doc projection of every body row equals the legacy frame's rows
+from pytacheck.core.doc import Doc  # noqa: E402
+
+nv = 0
+bad4 = []
+for p, name in zip(papers, inputs, strict=True):
+    for label, make in (("plain", lambda p=p: copy.deepcopy(p)),):
+        q = make()
+        legacy = L._text_frame(q)[0]
+        d = Doc.of(q)
+        body = [i for i in range(d.n) if d.body >> i & 1]
+        for idx in (body, body[::3], body[:1], []):
+            nv += 1
+            want = (
+                legacy.take(idx).reset_index(drop=True)
+                if idx
+                else legacy.iloc[0:0].reset_index(drop=True)
+            )
+            got = d.rows(idx, 0, [d.text[i] for i in idx]) if idx else d.rows([])
+            if not eq(want, got):
+                bad4.append((name, len(idx)))
+print(f"projection slices: {nv} cases, {len(bad4)} differ")
+for b in bad4[:10]:
+    print("DIFF4", b)
