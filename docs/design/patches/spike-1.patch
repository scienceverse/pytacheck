@@ -0,0 +1,118 @@
+"""The run context: which caches may be trusted, work counters, the mutation guard.
+
+A minimal version of ARCHITECTURE.md section 2.6 for the spike:
+
+* :func:`run_context` opens an *explicit* context (``report()``, ``run_modules``,
+  the harness, or a user's ``with`` block). Inputs are frozen there by contract,
+  so a :class:`~pytacheck.core.doc.Doc` built inside it is reused for every
+  module until the context ends, even when the paper's tables are DataFrames.
+* ``module_run`` alone opens a *transient* context that grants no trust: a Doc
+  is then reused only while the paper's tables are still the reader's raw
+  records (which no caller can edit in place).
+* ``PYTACHECK_COUNTERS=1`` counts work (Doc builds, façade calls, regex
+  compiles); ``PYTACHECK_CHECK_MUTATION=1`` fingerprints every Doc's source
+  tables at build time and again when the explicit context ends.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import contextvars
+import os
+from collections import Counter
+from collections.abc import Callable, Iterator
+from dataclasses import dataclass, field
+from typing import Any
+
+__all__ = ["RunContext", "StaleDocumentError", "count", "counters", "current", "run_context"]
+
+
+class StaleDocumentError(RuntimeError):
+    """A paper was edited in place while a run context trusted its Doc."""
+
+
+@dataclass(eq=False)
+class RunContext:
+    explicit: bool
+    counters: Counter[str] | None = None
+    #: (description, fingerprint function, fingerprint at build time)
+    watched: list[tuple[str, Callable[[], Any], Any]] = field(default_factory=list)
+
+    def watch(self, what: str, fingerprint: Callable[[], Any]) -> None:
+        if _CHECK_MUTATION:
+            self.watched.append((what, fingerprint, fingerprint()))
+
+    def check(self) -> None:
+        for what, fingerprint, before in self.watched:
+            if fingerprint() != before:
+                raise StaleDocumentError(
+                    f"{what} was edited in place inside a run context; papers must not be "
+                    "mutated while a run uses them"
+                )
+
+
+_CURRENT: contextvars.ContextVar[RunContext | None] = contextvars.ContextVar(
+    "pytacheck_run_context", default=None
+)
+_COUNTING = os.environ.get("PYTACHECK_COUNTERS") == "1"
+_CHECK_MUTATION = os.environ.get("PYTACHECK_CHECK_MUTATION") == "1"
+_GLOBAL: Counter[str] = Counter()
+
+
+def current() -> RunContext | None:
+    return _CURRENT.get()
+
+
+def trusted() -> RunContext | None:
+    """The active explicit context (the one whose Docs may be reused), or ``None``."""
+    ctx = _CURRENT.get()
+    return ctx if ctx is not None and ctx.explicit else None
+
+
+@contextlib.contextmanager
+def run_context(*, explicit: bool = True) -> Iterator[RunContext]:
+    """Open a run context; nested contexts share the outermost explicit one."""
+    outer = _CURRENT.get()
